# Pose height moves in 0.05-block steps so crouching and swimming do not snap.
execute if score @s SW.LanternPoseHeight matches 1 at @s positioned ~ ~-0.05 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 2 at @s positioned ~ ~-0.10 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 3 at @s positioned ~ ~-0.15 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 4 at @s positioned ~ ~-0.20 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 5 at @s positioned ~ ~-0.25 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 6 at @s positioned ~ ~-0.30 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 7 at @s positioned ~ ~-0.35 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 8 at @s positioned ~ ~-0.40 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 9 at @s positioned ~ ~-0.45 ~ run tp @s ~ ~ ~
execute if score @s SW.LanternPoseHeight matches 10.. at @s positioned ~ ~-0.50 ~ run tp @s ~ ~ ~
