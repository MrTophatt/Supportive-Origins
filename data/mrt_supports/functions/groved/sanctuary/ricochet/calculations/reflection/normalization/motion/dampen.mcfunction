# Reduce bounce speed by 10%
scoreboard players operation @s Groved.MotionX *= $DampeningNumerator Groved.ConstNum
scoreboard players operation @s Groved.MotionX /= $DampeningDenominator Groved.ConstNum
scoreboard players operation @s Groved.MotionY *= $DampeningNumerator Groved.ConstNum
scoreboard players operation @s Groved.MotionY /= $DampeningDenominator Groved.ConstNum
scoreboard players operation @s Groved.MotionZ *= $DampeningNumerator Groved.ConstNum
scoreboard players operation @s Groved.MotionZ /= $DampeningDenominator Groved.ConstNum
