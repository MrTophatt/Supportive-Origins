# Applies every persistent vanilla negative effect checked by Could Be Worse for 60 seconds.
# Instant Damage is intentionally excluded because it is instantaneous rather than a lasting effect.
effect give @s minecraft:bad_omen 60 0 false
effect give @s minecraft:blindness 60 0 false
effect give @s minecraft:darkness 60 0 false
effect give @s minecraft:hunger 60 0 false
effect give @s minecraft:levitation 60 0 false
effect give @s minecraft:mining_fatigue 60 0 false
effect give @s minecraft:nausea 60 0 false
effect give @s minecraft:poison 60 0 false
effect give @s minecraft:slowness 60 0 false
effect give @s minecraft:unluck 60 0 false
effect give @s minecraft:weakness 60 0 false
effect give @s minecraft:wither 60 0 false
