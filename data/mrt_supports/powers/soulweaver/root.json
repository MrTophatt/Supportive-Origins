{
    "hidden": true,
    "type": "origins:action_on_callback",
    "entity_action_gained": {
        "type": "origins:grant_advancement",
        "advancement": "mrt_supports:soulweaver/root"
    },
    "entity_action_lost": {
        "type": "origins:delay",
        "ticks": 1,
        "action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:or",
                "conditions": [
                    {
                        "type": "origins:origin",
                        "origin": "mrt_supports:soulweaver",
                        "layer": "origins:origin"
                    },
                    {
                        "type": "origins:origin",
                        "origin": "mrt_supports:fractured_weaver",
                        "layer": "origins:origin"
                    }
                ]
            },
            "if_action": {
                "type": "origins:nothing"
            },
            "else_action": {
                "type": "origins:execute_command",
                "command": "function mrt_supports:soulweaver/advancements/revoke-all"
            }
        }
    },
    "execute_chosen_when_orb": true
}
