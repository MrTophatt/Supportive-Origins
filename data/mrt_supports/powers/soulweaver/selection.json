{
    "hidden": true,
    "type": "apoli:multiple",

    "direction-indicators": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation $Selecting Supports.SW.ID = @s Supports.SW.ID"
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_indicator-set",
                    "bientity_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:target_action",
                                "action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "tag @s remove Supports.Soulweaver.IndicatorUpdated"
                                        },
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "tag @s remove Supports.Soulweaver.IndicatorSelected"
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/link_far-indicator-set"
                            },
                            {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/link_selected-indicator-set"
                            },
                            {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_indicator-set"
                            },
                            {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set"
                            }
                        ]
                    }
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_linked-set",
                    "bientity_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:execute_command",
                                "command": "scoreboard players operation $IndicatorOwner Supports.SW.ID = %a Supports.SW.ID",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "scoreboard players operation $IndicatorLink Supports.SW.LinkID = %t Supports.SW.LinkID",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:if_else",
                                "condition": {
                                    "type": "apoli:and",
                                    "conditions": [
                                        {
                                            "type": "apoli:or",
                                            "conditions": [
                                                {
                                                    "type": "apoli:and",
                                                    "conditions": [
                                                        {
                                                            "type": "apoli:actor_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:overworld" }
                                                        },
                                                        {
                                                            "type": "apoli:target_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:overworld" }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "apoli:and",
                                                    "conditions": [
                                                        {
                                                            "type": "apoli:actor_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:the_nether" }
                                                        },
                                                        {
                                                            "type": "apoli:target_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:the_nether" }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "apoli:and",
                                                    "conditions": [
                                                        {
                                                            "type": "apoli:actor_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:the_end" }
                                                        },
                                                        {
                                                            "type": "apoli:target_condition",
                                                            "condition": { "type": "apoli:dimension", "dimension": "minecraft:the_end" }
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "apoli:distance",
                                            "comparison": ">",
                                            "compare_to": 64
                                        }
                                    ]
                                },
                                "if_action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "execute as %a at %a anchored eyes facing entity %t eyes positioned ^ ^ ^6 run function mrt_supports:soulweaver/selection/indicator/update",
                                            "actor_selector": "%a",
                                            "target_selector": "%t"
                                        },
                                        {
                                            "type": "apoli:target_action",
                                            "action": {
                                                "type": "apoli:execute_command",
                                                "command": "tag @s add Supports.Soulweaver.LinkedFar"
                                            }
                                        },
                                        {
                                            "type": "apoli:actor_action",
                                            "action": {
                                                "type": "apoli:selector_action",
                                                "selector": "@e[type=minecraft:block_display,tag=Supports.Soulweaver.CurrentIndicator,limit=1]",
                                                "bientity_action": {
                                                    "type": "apoli:and",
                                                    "actions": [
                                                        {
                                                            "type": "apoli:add_to_entity_set",
                                                            "set": "mrt_supports:soulweaver/link_indicator-set"
                                                        },
                                                        {
                                                            "type": "apoli:add_to_entity_set",
                                                            "set": "mrt_supports:soulweaver/link_far-indicator-set"
                                                        },
                                                        {
                                                            "type": "apoli:add_to_entity_set",
                                                            "set": "mrt_supports:global/visible-link-indicators"
                                                        }
                                                    ]
                                                }
                                            }
                                        },
                                        {
                                            "type": "apoli:actor_action",
                                            "action": {
                                                "type": "apoli:selector_action",
                                                "selector": "@e[type=minecraft:marker,tag=Supports.Soulweaver.CurrentIndicatorMoveTarget,limit=1]",
                                                "bientity_action": {
                                                    "type": "apoli:add_to_entity_set",
                                                    "set": "mrt_supports:soulweaver/link_indicator-set"
                                                }
                                            }
                                        },
                                        {
                                            "type": "apoli:if_else",
                                            "condition": {
                                                "type": "apoli:in_entity_set",
                                                "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                                            },
                                            "if_action": {
                                                "type": "apoli:actor_action",
                                                "action": {
                                                    "type": "apoli:selector_action",
                                                    "selector": "@e[type=minecraft:block_display,tag=Supports.Soulweaver.CurrentIndicator,limit=1]",
                                                    "bientity_action": {
                                                        "type": "apoli:add_to_entity_set",
                                                        "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_indicator-set"
                                                    }
                                                }
                                            },
                                            "else_action": { "type": "apoli:nothing" }
                                        },
                                        {
                                            "type": "apoli:if_else",
                                            "condition": {
                                                "type": "apoli:in_entity_set",
                                                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                                            },
                                            "if_action": {
                                                "type": "apoli:actor_action",
                                                "action": {
                                                    "type": "apoli:selector_action",
                                                    "selector": "@e[type=minecraft:block_display,tag=Supports.Soulweaver.CurrentIndicator,limit=1]",
                                                    "bientity_action": {
                                                        "type": "apoli:add_to_entity_set",
                                                        "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set"
                                                    }
                                                }
                                            },
                                            "else_action": { "type": "apoli:nothing" }
                                        },
                                        {
                                            "type": "apoli:if_else",
                                            "condition": {
                                                "type": "apoli:in_entity_set",
                                                "set": "mrt_supports:soulweaver/link_selected-set"
                                            },
                                            "if_action": {
                                                "type": "apoli:actor_action",
                                                "action": {
                                                    "type": "apoli:and",
                                                    "actions": [
                                                        {
                                                            "type": "apoli:selector_action",
                                                            "selector": "@e[type=minecraft:block_display,tag=Supports.Soulweaver.CurrentIndicator,limit=1]",
                                                            "bientity_action": {
                                                                "type": "apoli:add_to_entity_set",
                                                                "set": "mrt_supports:soulweaver/link_selected-indicator-set"
                                                            }
                                                        },
                                                        {
                                                            "type": "apoli:execute_command",
                                                            "command": "tag @e[type=minecraft:block_display,tag=Supports.Soulweaver.CurrentIndicator,limit=1] add Supports.Soulweaver.IndicatorSelected"
                                                        }
                                                    ]
                                                }
                                            },
                                            "else_action": { "type": "apoli:nothing" }
                                        },
                                        {
                                            "type": "apoli:actor_action",
                                            "action": {
                                                "type": "apoli:execute_command",
                                                "command": "tag @e[tag=Supports.Soulweaver.CurrentIndicator] remove Supports.Soulweaver.CurrentIndicator"
                                            }
                                        }
                                    ]
                                },
                                "else_action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:target_action",
                                            "action": {
                                                "type": "apoli:execute_command",
                                                "command": "tag @s remove Supports.Soulweaver.LinkedFar"
                                            }
                                        },
                                        {
                                            "type": "apoli:actor_action",
                                            "action": {
                                                "type": "apoli:execute_command",
                                                "command": "function mrt_supports:soulweaver/selection/indicator/cleanup-current"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_indicator-set",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:command",
                                "command": "execute if entity @s[tag=Supports.Soulweaver.IndicatorUpdated]",
                                "comparison": "==",
                                "compare_to": 1
                            }
                        },
                        "if_action": { "type": "apoli:nothing" },
                        "else_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/link_far-indicator-set"
                                },
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/link_selected-indicator-set"
                                },
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_indicator-set"
                                },
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set"
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": { "type": "apoli:execute_command", "command": "kill @s" }
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },

    "selector": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation $Selecting Supports.SW.ID = @s Supports.SW.ID"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute as @e[scores={SW.Selected=1..}] if score @s SW.Selected = $Selecting Supports.SW.ID run scoreboard players reset @s SW.Selected"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.IndicatorRayHit"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.SelectionHasTarget"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @e[tag=Supports.Soulweaver.SelectionCandidate] remove Supports.Soulweaver.SelectionCandidate"
                },
                {
                    "type": "apoli:raycast",
                    "distance": 6.5,
                    "command_step": 0.1,
                    "block": false,
                    "entity": false,
                    "fluid_handling": "none",
                    "command_along_ray": "function mrt_supports:soulweaver/selection/indicator/try-select"
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:command",
                        "command": "execute unless entity @s[tag=Supports.Soulweaver.IndicatorRayHit]",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    "if_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/link_linked-set",
                                "bientity_condition": {
                                    "type": "apoli:distance",
                                    "comparison": "<=",
                                    "compare_to": 64
                                },
                                "bientity_action": {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "tag @s add Supports.Soulweaver.SelectionCandidate"
                                    }
                                }
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/selection/close/start"
                            },
                            {
                                "type": "apoli:raycast",
                                "distance": 64,
                                "command_step": 0.25,
                                "block": false,
                                "entity": true,
                                "pierce": true,
                                "radius": { "x": 2.0, "y": 2.0, "z": 2.0 },
                                "fluid_handling": "none",
                                "command_along_ray": "function mrt_supports:soulweaver/selection/close/sample"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/selection/close/finish"
                            },
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/link_linked-set",
                                "bientity_action": {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "tag @s remove Supports.Soulweaver.SelectionCandidate"
                                    }
                                }
                            }
                        ]
                    },
                    "else_action": { "type": "apoli:nothing" }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute if entity @s[tag=Supports.Soulweaver.IndicatorRayHit] run tag @s add Supports.Soulweaver.SelectionHasTarget"
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:command",
                        "command": "execute if entity @s[tag=Supports.Soulweaver.SelectionHasTarget]",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    "if_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/link_selected-set",
                                "bientity_action": {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:command",
                                            "command": "execute if score @s SW.Selected = $Selecting Supports.SW.ID",
                                            "comparison": "==",
                                            "compare_to": 1
                                        }
                                    },
                                    "if_action": { "type": "apoli:nothing" },
                                    "else_action": {
                                        "type": "apoli:remove_from_entity_set",
                                        "set": "mrt_supports:soulweaver/link_selected-set"
                                    }
                                }
                            },
                            {
                                "type": "apoli:selector_action",
                                "selector": "@e[scores={SW.Selected=1..}]",
                                "bientity_condition": {
                                    "type": "apoli:in_entity_set",
                                    "set": "mrt_supports:soulweaver/link_linked-set"
                                },
                                "bientity_action": {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:command",
                                            "command": "execute if score @s SW.Selected = $Selecting Supports.SW.ID",
                                            "comparison": "==",
                                            "compare_to": 1
                                        }
                                    },
                                    "if_action": {
                                        "type": "apoli:add_to_entity_set",
                                        "set": "mrt_supports:soulweaver/link_selected-set"
                                    },
                                    "else_action": { "type": "apoli:nothing" }
                                }
                            }
                        ]
                    },
                    "else_action": {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_selected-set",
                        "bientity_action": {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/link_selected-set"
                        }
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute as @e[scores={SW.Selected=1..}] if score @s SW.Selected = $Selecting Supports.SW.ID run scoreboard players reset @s SW.Selected"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.IndicatorRayHit"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.SelectionHasTarget"
                }
            ]
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_linked-set",
            "comparison": ">",
            "compare_to": 0
        }
    },

    "cleanup": {
        "type": "apoli:action_on_callback",
        "entity_action_removed": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "bientity_action": {
                        "type": "apoli:remove_from_entity_set",
                        "set": "mrt_supports:soulweaver/link_selected-set"
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/selection/cleanup-owner"
                }
            ]
        },
        "entity_action_lost": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "bientity_action": {
                        "type": "apoli:remove_from_entity_set",
                        "set": "mrt_supports:soulweaver/link_selected-set"
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/selection/cleanup-owner"
                }
            ]
        }
    },

    "direction-glow": {
        "type": "apoli:entity_glow",
        "use_teams": false,
        "red": 0.086,
        "green": 0.573,
        "blue": 0.78,
        "bientity_condition": {
            "type": "apoli:and",
            "conditions": [
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_far-indicator-set" },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_selected-indicator-set", "inverted": true },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_indicator-set", "inverted": true },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set", "inverted": true }
            ]
        }
    },

    "glow": {
        "type": "apoli:entity_glow",
        "use_teams": false,
        "red": 0.086,
        "green": 0.573,
        "blue": 0.78,
        "bientity_condition": {
            "type": "apoli:and",
            "conditions": [
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_linked-set" },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_selected-set", "inverted": true },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set", "inverted": true },
                { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set", "inverted": true }
            ]
        }
    },

    "selected-glow": {
        "type": "apoli:entity_glow",
        "use_teams": false,
        "red": 0.545,
        "green": 0.863,
        "blue": 1,
        "bientity_condition": {
            "type": "apoli:or",
            "conditions": [
                {
                    "type": "apoli:and",
                    "conditions": [
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_linked-set" },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_selected-set" },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set", "inverted": true },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set", "inverted": true }
                    ]
                },
                {
                    "type": "apoli:and",
                    "conditions": [
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_far-indicator-set" },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/link_selected-indicator-set" },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_indicator-set", "inverted": true },
                        { "type": "apoli:in_entity_set", "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set", "inverted": true }
                    ]
                }
            ]
        }
    }
}
