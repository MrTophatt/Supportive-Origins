{
    "name": "Soul Recall",
    "description": "Pull upon the thread of a woven soul, drawing them to you -- or yourself to them.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Call back a linked soul, or guide youself to a linked soul with %s"
        }
    ],

    "type": "origins:multiple",

    "single-tp": {
        "type": "origins:active_self",
        "cooldown": 200,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/resource_bar.png",
            "bar_index": 3
        },
        "key": {
            "key": "key.origins.secondary_active"
        },
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:sneaking"
            },
            "if_action": {
                "type": "origins:execute_command",
                "command": "function mrt_supports:soulweaver/teleport-weaver"
            },
            "else_action": {
                "type": "origins:execute_command",
                "command": "function mrt_supports:soulweaver/teleport-to-weaver"
            }
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:command",
                    "command": "execute if entity @a[tag=linked,tag=selected,distance=..151] if score @a[tag=linked,tag=selected,distance=..151,limit=1] soulLinkID = @s soulLinkID",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/teleport_mass-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "mass-tp-resource": {
        "type": "origins:resource",
        "min": 0,
        "max": 60,
        "start_value": 0,
        "hud_render": {
            "bar_index": 3,
            "condition": {
                "type": "origins:resource",
                "resource": "mrt_supports:soulweaver/teleport_mass-tp-resource",
                "comparison": "!=",
                "compare_to": 0
            }
        }
    },
    "mass-tp-resource-reset": {
        "type": "origins:action_over_time",
        "rising_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:soulweaver/teleport_mass-tp-resource",
            "change": 0,
            "operation": "set"
        },
        "condition": {
            "type": "apugli:key_pressed",
            "key": {
                "key": "key.origins.secondary_active"
            },
            "inverted": true
        },
        "interval": 1
    },
    "mass-tp-cooldown": {
        "type": "origins:cooldown",
        "cooldown": 400,
        "hud_render": {
            "bar_index": 3,
            "condition": {
                "type": "origins:resource",
                "resource": "mrt_supports:soulweaver/teleport_mass-tp-cooldown",
                "comparison": "!=",
                "compare_to": 0
            }
        }
    },

    "mass-tp": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:soulweaver/teleport_mass-tp-resource",
                    "change": 1
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:resource",
                        "resource": "mrt_supports:soulweaver/teleport_mass-tp-resource",
                        "comparison": "==",
                        "compare_to": 60
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:action_on_set",
                                "set": "mrt_supports:soulweaver/soullink_set",
                                "bientity_action": {
                                    "type": "origins:target_action",
                                    "action": {
                                        "type": "origins:execute_command",
                                        "command": "execute at @a[tag=soulweaver] if score @s soulLinkID = @p soulLinkID run tp @s ~ ~ ~"
                                    }
                                }
                            },
                            {
                                "type": "origins:trigger_cooldown",
                                "power": "mrt_supports:soulweaver/teleport_mass-tp-cooldown"
                            },
                            {
                                "type": "origins:change_resource",
                                "resource": "mrt_supports:soulweaver/teleport_mass-tp-resource",
                                "change": 0,
                                "operation": "set"
                            }
                        ]
                    }
                }
            ]
        },
        "key": {
            "key": "key.origins.secondary_active",
            "continuous": true
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:command",
                    "command": "execute if entity @a[tag=linked,tag=selected,distance=..151] if score @a[tag=linked,tag=selected,distance=..151,limit=1] soulLinkID = @s soulLinkID",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/teleport_mass-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/teleport_single-tp",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    }
}