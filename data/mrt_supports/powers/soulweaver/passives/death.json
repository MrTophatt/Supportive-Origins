{
    "hidden": true,
    "type": "apoli:multiple",

    "consume-lantern-before-death": {
        "type": "apoli:prevent_death",
        "condition": {
            "type": "apoli:command",
            "command": "function mrt_supports:soulweaver/death/prepare",
            "comparison": "<",
            "compare_to": 0
        }
    },

    "clear-links-on-death": {
        "type": "apoli:action_on_death",
        "bientity_action": {
            "type": "apoli:target_action",
            "action": {
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/death/capture"
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/effects/death-weaver"
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_selected-set",
                        "bientity_action": {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/link_selected-set"
                        }
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_linked-set",
                        "bientity_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "execute as %t run title @s actionbar [{\"text\":\"⚠ \"},{\"selector\":\"%a\",\"color\":\"#65E9F7\",\"bold\":true},{\"text\":\"'s soul has fractured. Your woven link has been severed.\",\"color\":\"#21AEFF\"}]",
                                    "actor_selector": "%a",
                                    "target_selector": "%t"
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/death-linked"
                                    }
                                },
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/link_selected-set"
                                },
                                {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/link_linked-set"
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_stand-set",
                        "bientity_action": {
                            "type": "apoli:target_action",
                            "action": {
                                "type": "apoli:execute_command",
                                "command": "kill @s"
                            }
                        }
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_indicator-set",
                        "bientity_action": {
                            "type": "apoli:target_action",
                            "action": {
                                "type": "apoli:execute_command",
                                "command": "kill @s"
                            }
                        }
                    },
                    {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/death/after-death"
                    }
                ]
            }
        }
    },

    "apply-fracture-after-respawn": {
        "type": "apoli:action_on_callback",
        "entity_action_respawned": {
            "type": "apoli:delay",
            "ticks": 1,
            "action": {
                "type": "apoli:if_else",
                "condition": {
                    "type": "apoli:or",
                    "conditions": [
                                {
                                    "type": "apoli:nbt",
                                    "nbt": "{Tags:[\"Supports.Soulweaver.SoulFracture\"]}"
                                },
                                {
                                    "type": "apoli:nbt",
                                    "nbt": "{Tags:[\"Supports.Soulweaver.ShortFracture\"]}"
                                },
                                {
                                    "type": "apoli:nbt",
                                    "nbt": "{Tags:[\"Supports.Soulweaver.LongFracture\"]}"
                                }
                    ]
                },
                "if_action": {
                    "type": "apoli:execute_command",
                    "command": "origin set @s origins:origin mrt_supports:fractured_weaver"
                },
                "else_action": {
                    "type": "apoli:nothing"
                }
            }
        }
    }
}
