{
    "name": "Soul Weaver Ability Unlocks",
    "description": "Announces newly unlocked Soul Weaver abilities.",
    "hidden": true,
    "type": "origins:multiple",

    "one-link-notified": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        },
        "max_action": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:soulweaver/unlocks/one-link"
        }
    },

    "two-link-notified": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        },
        "max_action": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:soulweaver/unlocks/two-links"
        }
    },

    "three-link-notified": {
        "type": "origins:resource",
