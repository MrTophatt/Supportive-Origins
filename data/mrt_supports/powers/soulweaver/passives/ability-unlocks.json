    "five-link-notified": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        },
        "max_action": {
            "type": "origins:execute_command",
            "command": "tellraw @s [{\"text\":\"Ability unlocked: \",\"color\":\"#21AEFF\"},{\"text\":\"Guardian Weaver \",\"color\":\"aqua\",\"bold\":true},{\"text\":\"[\",\"color\":\"dark_aqua\"},{\"keybind\":\"key.origins.nonary_active\",\"color\":\"white\"},{\"text\":\"]\",\"color\":\"dark_aqua\"}]"
        }
    },

    "one-link-watcher": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "apoli:entity_set_size",
                "set": "mrt_supports:soulweaver/link_stand-set",
                "comparison": ">=",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/passives/ability-unlocks_one-link-notified",
                    "comparison": "==",
                    "compare_to": 0
                },
                "if_action": {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:soulweaver/passives/ability-unlocks_one-link-notified",
                    "operation": "set",
                    "change": 1
                },
                "else_action": {
                    "type": "origins:nothing"
                }
            },
            "else_action": {
                "type": "origins:change_resource",
                "resource": "mrt_supports:soulweaver/passives/ability-unlocks_one-link-notified",
                "operation": "set",
                "change": 0
            }
        }
    },

