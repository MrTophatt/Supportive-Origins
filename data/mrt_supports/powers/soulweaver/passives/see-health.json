                                            "if_action": {
                                                "type": "sync:execute_command",
                                                "command": "execute as %a run title @s actionbar [{\"text\":\"The nearest linked soul [\",\"color\":\"#289DA3\"},{\"selector\":\"%t\",\"color\":\"#65E9F7\"},{\"text\":\"] has \",\"color\":\"#289DA3\"},{\"score\":{\"name\":\"%t\",\"objective\":\"SW.Health\"},\"color\":\"#F71414\"},{\"text\":\" HP\",\"color\":\"#F71414\"},{\"text\":\" \",\"color\":\"#289DA3\"},{\"text\":\"|\",\"color\":\"#289DA3\",\"bold\":true},{\"text\":\" Strand of \",\"color\":\"#289DA3\"},{\"text\":\"Fervor\",\"color\":\"#FF400D\"}]",
                                                "actor_selector": "%a",
                                                "target_selector": "%t"
