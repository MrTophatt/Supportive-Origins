{
    "name": "Soul Leap",
    "description": "Launch upward with woven soul energy. Stronger with more woven souls and on Soul Sand or Soul Soil.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "key": "key.jump",
            "text": "Leap while airborne with %s"
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Launch strength increases with woven souls, up to 4",
                "color": "aqua"
            }
        }
    ],
    "type": "apoli:multiple",

    "charges": {
        "type": "apoli:resource",
        "min": 0,
        "max": 320,
        "start_value": 320,
        "hud_render": {
            "sprite_location": "origins:textures/gui/sprites/hud_render/spiderkolo/resource_bar_03.png",
            "bar_index": 16,
            "condition": {
                "type": "apoli:resource",
                "resource": "mrt_supports:soulweaver/passives/soul-leap_charges",
                "comparison": "!=",
                "compare_to": 320
            }
        }
    },

    "refill-charges": {
        "type": "apoli:action_over_time",
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "mrt_supports:soulweaver/passives/soul-leap_charges",
            "change": 1
        },
        "interval": 1
    },

    "leap": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:block_collision",
                        "offset_y": -1.5,
                        "block_condition": {
                            "type": "apoli:or",
                            "conditions": [
                                {
                                    "type": "apoli:block",
                                    "block": "minecraft:soul_sand"
                                },
                                {
                                    "type": "apoli:block",
                                    "block": "minecraft:soul_soil"
                                }
                            ]
                        }
                    },
                    "if_action": {
                        "type": "apoli:add_velocity",
                        "x": "velocity_x",
                        "y": "0.82 + 0.07 * min(4, resource(mrt_supports:soulweaver/link_counter))",
                        "z": "velocity_z",
                        "set": true
                    },
                    "else_action": {
                        "type": "apoli:add_velocity",
                        "x": "velocity_x",
                        "y": "0.65 + 0.07 * min(4, resource(mrt_supports:soulweaver/link_counter))",
                        "z": "velocity_z",
                        "set": true
                    }
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:soulweaver/passives/soul-leap_charges",
                    "change": -160
                },
                {
                    "type": "apoli:set_fall_distance",
                    "fall_distance": 0
                },
                {
                    "type": "apoli:execute_command",
                    "command": "particle minecraft:soul_fire_flame ~ ~0.15 ~ 0.25 0.08 0.25 0.025 12 force @a[distance=..32]"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "particle minecraft:soul ~ ~0.15 ~ 0.18 0.05 0.18 0.035 6 force @a[distance=..32]"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "playsound minecraft:entity.allay.item_given player @a[distance=..32] ~ ~ ~ 0.65 0.7"
                }
            ]
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.jump",
            "continuous": false
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:soulweaver/passives/soul-leap_charges",
                    "comparison": ">=",
                    "compare_to": 160
                },
                {
                    "type": "apoli:nbt",
                    "nbt": "{OnGround:0b}"
                },
                {
                    "type": "apoli:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": ">",
                    "compare_to": 0.0,
                    "inverted": true
                },
                {
                    "type": "apoli:fluid_height",
                    "fluid": "minecraft:lava",
                    "comparison": ">",
                    "compare_to": 0.0,
                    "inverted": true
                }
            ]
        }
    }
}
