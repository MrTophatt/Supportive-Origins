{
    "name": "Woven Bond",
    "description": "Entwine a soul with yourself, letting you sense their presence and well-being.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/star.png",
            "text": "Right-click a player to weave/detach their soul"
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "You cannot weave to other Soul Weavers, nor players woven to another Soul Weaver. You have a maximum of 5 links"
        }
    ],
    "type": "origins:multiple",

    "set": {
        "type": "origins:entity_set"
    },

    "link-count": {
        "type": "origins:resource",
        "min": 0,
        "max": 5,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 19
        }
    },

    "precaution-reset-link-counter": {
        "type": "origins:action_on_callback",
        "entity_action_chosen": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:soulweaver/soullink_link-count",
            "change": 0,
            "operation": "set"
        },
        "execute_chosen_when_orb": true
    },

    "link": {
        "type": "origins:action_on_entity_use",
        "bientity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:target_condition",
                "condition": {
                    "type": "origins:origin",
                    "origin": "mrt_supports:soulweaver",
                    "layer": "origins:origin"
                }
            },
            "if_action": {
                "type": "origins:actor_action",
                "action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:trigger_cooldown",
                            "power": "mrt_supports:soulweaver/passives/see-health_cooldown"
                        },
                        {
                            "type": "origins:execute_command",
                            "command": "title @s actionbar {\"text\":\"⚠ Cannot weave another Soul Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                        }
                    ]
                }
            },
            "else_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:command",
                        "command": "execute if entity @s[tag=linked]",
                        "comparison": "==",
                        "compare_to": 1
                    }
                },
                "if_action": {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:trigger_cooldown",
                                "power": "mrt_supports:soulweaver/passives/see-health_cooldown"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"⚠ The player's soul is weaved to another Soul Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                            }
                        ]
                    }
                },
                "else_action": {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:actor_condition",
                        "condition": {
                            "type": "origins:resource",
                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                            "comparison": "==",
                            "compare_to": 5
                        }
                    },
                    "if_action": {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:trigger_cooldown",
                                "power": "mrt_supports:soulweaver/passives/see-health_cooldown"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"⚠ Max souls weaved\",\"color\":\"#21AEFF\",\"bold\":true}"
                            }
                        ]
                        }
                    },
                    "else_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:add_to_set",
                                "set": "mrt_supports:soulweaver/soullink_set"
                            },
                            {
                                "type": "origins:target_action",
                                "action": {
                                    "type": "origins:execute_command",
                                    "command": "function mrt_supports:soulweaver/linking/target"
                                }
                            },
                            {
                                "type": "origins:actor_action",
                                "action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/linking/weaver"
                                        },
                                        {
                                            "type": "origins:action_on_set",
                                            "set": "mrt_supports:soulweaver/soullink_set",
                                            "bientity_action": {
                                                "type": "origins:and",
                                                "actions": [
                                                    {
                                                        "type": "origins:actor_action",
                                                        "action": {
                                                            "type": "origins:execute_command",
                                                            "command": "scoreboard players operation #temp soulLinkID = @s soulLinkID"
                                                        }
                                                    },
                                                    {
                                                        "type": "origins:target_action",
                                                        "action": {
                                                            "type": "origins:execute_command",
                                                            "command": "scoreboard players operation @s soulLinkID = #temp soulLinkID"
                                                        }
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "type": "origins:if_else_list",
                                            "actions": [
                                                {
                                                    "condition": {
                                                        "type": "origins:resource",
                                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                        "comparison": "==",
                                                        "compare_to": 1
                                                    },
                                                    "action": {
                                                        "type": "origins:execute_command",
                                                        "command": "function mrt_supports:soulweaver/buffs/level1"
                                                    }
                                                },
                                                {
                                                    "condition": {
                                                        "type": "origins:resource",
                                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                        "comparison": "==",
                                                        "compare_to": 2
                                                    },
                                                    "action": {
                                                        "type": "origins:execute_command",
                                                        "command": "function mrt_supports:soulweaver/buffs/level2"
                                                    }
                                                },
                                                {
                                                    "condition": {
                                                        "type": "origins:resource",
                                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                        "comparison": "==",
                                                        "compare_to": 3
                                                    },
                                                    "action": {
                                                        "type": "origins:execute_command",
                                                        "command": "function mrt_supports:soulweaver/buffs/level3"
                                                    }
                                                },
                                                {
                                                    "condition": {
                                                        "type": "origins:resource",
                                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                        "comparison": "==",
                                                        "compare_to": 4
                                                    },
                                                    "action": {
                                                        "type": "origins:execute_command",
                                                        "command": "function mrt_supports:soulweaver/buffs/level4"
                                                    }
                                                },
                                                {
                                                    "condition": {
                                                        "type": "origins:resource",
                                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                        "comparison": "==",
                                                        "compare_to": 5
                                                    },
                                                    "action": {
                                                        "type": "origins:execute_command",
                                                        "command": "function mrt_supports:soulweaver/buffs/level5"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            }
        },
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:entity_type",
                        "entity_type": "minecraft:player"
                    }
                },
                {
                    "type": "origins:in_set",
                    "set": "mrt_supports:soulweaver/soullink_set",
                    "inverted": true
                }
            ]
        },
        "item_condition": {
            "type": "origins:empty"
        },
        "hands": [
            "main_hand"
        ],
        "condition": {
            "set": "mrt_supports:soulweaver/soullink_set",
            "type": "origins:set_size",
            "comparison": "<=",
            "compare_to": 5
        }
    },
    "unlink": {
        "type": "origins:action_on_entity_use",
        "bientity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "tag @s add removingLink"
                            },
                            { 
                                "type": "origins:remove_power",
                                "power": "mrt_supports:soulweaver/helpers/mercy"
                            },
                            {
                                "type": "origins:remove_power",
                                "power": "mrt_supports:soulweaver/helpers/selected"
                            }
                        ]
                    }
                },
                {
                    "type": "origins:actor_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:action_on_set",
                                "set": "mrt_supports:soulweaver/soullink_set",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:actor_action",
                                            "action": {
                                                "type": "origins:and",
                                                "actions": [
                                                    {
                                                        "type": "origins:execute_command",
                                                        "command": "scoreboard players operation #temp soulLinkID = @s soulLinkID"
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:if_else",
                                                "condition": {
                                                    "type": "origins:nbt",
                                                    "nbt": "{Tags: ['removingLink']}"
                                                },
                                                "if_action": {
                                                    "type": "origins:execute_command",
                                                    "command": "function mrt_supports:soulweaver/unlinking/target"
                                                }
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/unlinking/weaver"
                            },
                            {
                                "type": "origins:if_else_list",
                                "actions": [
                                    {
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                                            "comparison": "==",
                                            "compare_to": 1
                                        },
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/buffs/level1"
                                        }
                                    },
                                    {
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                                            "comparison": "==",
                                            "compare_to": 2
                                        },
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/buffs/level2"
                                        }
                                    },
                                    {
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                                            "comparison": "==",
                                            "compare_to": 3
                                        },
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/buffs/level3"
                                        }
                                    },
                                    {
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                                            "comparison": "==",
                                            "compare_to": 4
                                        },
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/buffs/level4"
                                        }
                                    },
                                    {
                                        "condition": {
                                            "type": "origins:resource",
                                            "resource": "mrt_supports:soulweaver/soullink_link-count",
                                            "comparison": "==",
                                            "compare_to": 5
                                        },
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "function mrt_supports:soulweaver/buffs/level5"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "origins:remove_from_set",
                    "set": "mrt_supports:soulweaver/soullink_set"
                }
            ]
        },
        "bientity_condition": {
            "type": "origins:in_set",
            "set": "mrt_supports:soulweaver/soullink_set"
        },
        "item_condition": {
            "type": "origins:empty"
        },
        "hands": [
            "main_hand"
        ]
    },
    "sync": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "execute at @a[tag=linked] if score @p soulLinkID = @s soulLinkID run tag @p add sameScore"
                },
                {
                    "type": "origins:selector_action",
                    "selector": "@a[tag=sameScore]",
                    "bientity_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:add_to_set",
                                "set": "mrt_supports:soulweaver/soullink_set"
                            },
                            {
                                "type": "origins:target_action",
                                "action": {
                                    "type": "origins:execute_command",
                                    "command": "tag @s remove sameScore"
                                }
                            },
                            {
                                "type": "origins:actor_action",
                                "action": {
                                    "type": "origins:if_else_list",
                                    "actions": [
                                        {
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                "comparison": "==",
                                                "compare_to": 1
                                            },
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/buffs/level1"
                                            }
                                        },
                                        {
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                "comparison": "==",
                                                "compare_to": 2
                                            },
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/buffs/level2"
                                            }
                                        },
                                        {
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                "comparison": "==",
                                                "compare_to": 3
                                            },
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/buffs/level3"
                                            }
                                        },
                                        {
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                "comparison": "==",
                                                "compare_to": 4
                                            },
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/buffs/level4"
                                            }
                                        },
                                        {
                                            "condition": {
                                                "type": "origins:resource",
                                                "resource": "mrt_supports:soulweaver/soullink_link-count",
                                                "comparison": "==",
                                                "compare_to": 5
                                            },
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/buffs/level5"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "interval": 1
    },
    "sync-unlink": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:action_on_set",
            "set": "mrt_supports:soulweaver/soullink_set",
            "bientity_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "eggolib:compare_score",
                    "actor_objective": "soulLinkID",
                    "target_objective": "soulLinkID",
                    "comparison": "!="
                },
                "if_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:remove_from_set",
                            "set": "mrt_supports:soulweaver/soullink_set"
                        }
                    ]
                }
            }
        },
        "interval": 1
    },
    "death-unlink": {
        "type": "origins:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:action_on_set",
                "set": "mrt_supports:soulweaver/soullink_set",
                "bientity_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:remove_from_set",
                            "set": "mrt_supports:soulweaver/soullink_set"
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:execute_command",
                                        "command": "function mrt_supports:soulweaver/unlinking/death"
                                    },
                                    { 
                                        "type": "origins:remove_power",
                                        "power": "mrt_supports:soulweaver/helpers/mercy"
                                    },
                                    {
                                        "type": "origins:remove_power",
                                        "power": "mrt_supports:soulweaver/helpers/selected"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "mrt_supports:soulweaver/soullink_link-count",
                                        "change": 0,
                                        "operation": "set"
                                    },
                                    {
                                        "type": "origins:execute_command",
                                        "command": "function mrt_supports:soulweaver/buffs/revokebuffs"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        }
    },

    "glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 0.086,
        "green": 0.573,
        "blue": 0.78,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/selected",
                        "inverted": true
                    }
                },
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/mercy",
                        "inverted": true
                    }
                },
                {
                    "type": "origins:in_set",
                    "set": "mrt_supports:soulweaver/soullink_set"
                }
            ]
        }
    },
    "select-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 0.545,
        "green": 0.863,
        "blue": 1,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/selected"
                    }
                },
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/mercy",
                        "inverted": true
                    }
                },
                {
                    "type": "origins:in_set",
                    "set": "mrt_supports:soulweaver/soullink_set"
                }
            ]
        }
    },
    "mercy-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 0.129,
        "green": 0.298,
        "blue": 0.949,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/selected",
                        "inverted": true
                    }
                },
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/mercy"
                    }
                },
                {
                    "type": "origins:in_set",
                    "set": "mrt_supports:soulweaver/soullink_set"
                }
            ]
        }
    },
    "mercy-glow-selected": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 0.271,
        "green": 0.341,
        "blue": 0.61,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/selected"
                    }
                },
                {
                    "type": "origins:target_condition",
                    "condition": {
                        "type": "origins:power",
                        "power": "mrt_supports:soulweaver/helpers/mercy"
                    }
                },
                {
                    "type": "origins:in_set",
                    "set": "mrt_supports:soulweaver/soullink_set"
                }
            ]
        }
    },

    "remove-tag": {
        "type": "origins:action_on_callback",
        "entity_action_lost": {
            "type": "origins:action_on_set",
            "set": "mrt_supports:soulweaver/soullink_set",
            "bientity_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:execute_command",
                            "command": "tag @s remove linked"
                        }
                    },
                    {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:execute_command",
                            "command": "function mrt_supports:soulweaver/removebuffs"
                        }
                    },
                    {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:execute_command",
                            "command": "function mrt_supports:soulweaver/removebuffs"
                        }
                    },
                    {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:remove_power",
                            "power": "mrt_supports:soulweaver/helpers/mercy"
                        }
                    }
                ]   
            }
        },
        "execute_chosen_when_orb": false
    }
}