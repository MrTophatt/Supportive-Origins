{
    "type": "origins:multiple",
    "guardian-sigil": {
        "type": "origins:action_over_time",
        "interval": 10,
        "entity_action": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:soulweaver/guardian/mark-particles"
        }
    },
    "hit-count": {
        "type": "origins:resource",
        "min": 0,
        "max": 2,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "count-hit": {
        "type": "origins:modify_damage_taken",
        "self_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:soulweaver/given/guarded-soul_hit-count",
            "operation": "add",
            "change": 1
        },
        "condition": {
            "type": "origins:resource",
            "resource": "mrt_supports:soulweaver/given/guarded-soul_hit-count",
            "comparison": "<",
            "compare_to": 2
        }
    },
    "redirect-1": {
        "type": "origins:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total_multiplicative",
            "value": -1
        },
        "damage_condition": {
            "type": "origins:amount",
            "comparison": "<=",
            "compare_to": 1
        },
        "self_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:soulweaver/given/guarded-soul_hit-count",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:soulweaver/guardian/redirect-1"
                }
            ]
        },
        "condition": {
            "type": "origins:resource",
            "resource": "mrt_supports:soulweaver/given/guarded-soul_hit-count",
