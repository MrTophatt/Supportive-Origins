{
    "type": "apoli:multiple",

    "set": {
        "type": "apoli:entity_set"
    },

    "prevent-vibrations": {
        "type": "apoli:prevent_game_event",
        "tag": "minecraft:vibrations"
    },

    "position": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "data merge entity @s {Invisible:1b}"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute in minecraft:overworld run tp @s 8 -60 8"
                }
            ]
        }
    },

    "reclaim-owner-set": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation $Repair Supports.SW.ID = @s Supports.SW.ID"
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@a",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:and",
                                "conditions": [
                                    {
                                        "type": "apoli:power",
                                        "power": "mrt_supports:soulweaver/link"
                                    },
                                    {
                                        "type": "apoli:command",
                                        "command": "execute if score @s Supports.SW.ID = $Repair Supports.SW.ID",
                                        "comparison": "==",
                                        "compare_to": 1
                                    }
                                ]
                            }
                        },
                        "if_action": {
                            "type": "apoli:invert",
                            "action": {
                                "type": "apoli:add_to_entity_set",
                                "set": "mrt_supports:soulweaver/link_stand-set"
                            }
                        },
                        "else_action": {
                            "type": "apoli:nothing"
                        }
                    }
                }
            ]
        }
    },

    "repair-linked-entity": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "*:*_set",
            "bientity_action": {
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "scoreboard players operation $Repair Supports.SW.ID = @s Supports.SW.ID"
                        }
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "scoreboard players operation %t Supports.SW.ID = %a Supports.SW.ID",
                        "actor_selector": "%a",
                        "target_selector": "%t"
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "scoreboard players operation %t Supports.SW.LinkID = %a Supports.SW.LinkID",
                        "actor_selector": "%a",
                        "target_selector": "%t"
                    },
                    {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "tag @s add Supports.Soulweaver.LinkedEntity"
                        }
                    },
                    {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "apoli:power grant @s mrt_supports:soulweaver/given/linked-player mrt_supports:soulweaver"
                        }
                    },
                    {
                        "type": "apoli:invert",
                        "action": {
                            "type": "apoli:add_to_entity_set",
                            "set": "mrt_supports:soulweaver/given/linked-player_set"
                        }
                    },
                    {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:selector_action",
                            "selector": "@a",
                            "bientity_action": {
                                "type": "apoli:if_else",
                                "condition": {
                                    "type": "apoli:target_condition",
                                    "condition": {
                                        "type": "apoli:and",
                                        "conditions": [
                                            {
                                                "type": "apoli:power",
                                                "power": "mrt_supports:soulweaver/link"
                                            },
                                            {
                                                "type": "apoli:command",
                                                "command": "execute if score @s Supports.SW.ID = $Repair Supports.SW.ID",
                                                "comparison": "==",
                                                "compare_to": 1
                                            }
                                        ]
                                    }
                                },
                                "if_action": {
                                    "type": "apoli:invert",
                                    "action": {
                                        "type": "apoli:add_to_entity_set",
                                        "set": "mrt_supports:soulweaver/link_linked-set"
                                    }
                                },
                                "else_action": {
                                    "type": "apoli:nothing"
                                }
                            }
                        }
                    }
                ]
            }
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "*:*_set",
            "comparison": ">",
            "compare_to": 0
        }
    },

    "apoli-link-buffs": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/buffs/prepare-count-from-stand"
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "*:*_set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "function mrt_supports:soulweaver/buffs/apply-count"
                        }
                    }
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@a[tag=Supports.Soulweaver.Owner]",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:command",
                                "command": "execute if score @s Supports.SW.ID = $BuffOwner Supports.SW.ID",
                                "comparison": "==",
                                "compare_to": 1
                            }
                        },
                        "if_action": {
                            "type": "apoli:target_action",
                            "action": {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/buffs/apply-count"
                            }
                        },
                        "else_action": {
                            "type": "apoli:nothing"
                        }
                    }
                }
            ]
        }
    },

    "kill-if-owner-lost-origin": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation $Repair Supports.SW.ID = @s Supports.SW.ID"
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@a[tag=!Supports.Soulweaver.LinkedEntity]",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:and",
                                "conditions": [
                                    {
                                        "type": "apoli:command",
                                        "command": "execute if score @s Supports.SW.ID = $Repair Supports.SW.ID",
                                        "comparison": "==",
                                        "compare_to": 1
                                    },
                                    {
                                        "type": "apoli:power",
                                        "power": "mrt_supports:soulweaver/link",
                                        "inverted": true
                                    }
                                ]
                            }
                        },
                        "if_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/buffs/clear"
                                    }
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "tag @s remove Supports.Soulweaver.Owner"
                                    }
                                },
                                {
                                    "type": "apoli:actor_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "kill @s"
                                    }
                                }
                            ]
                        },
                        "else_action": {
                            "type": "apoli:nothing"
                        }
                    }
                }
            ]
        }
    }
}