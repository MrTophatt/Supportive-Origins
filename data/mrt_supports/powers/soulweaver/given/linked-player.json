{
    "type": "origins:multiple",

    "set": {
        "type": "apoli:entity_set",
        "tick_rate": 1,
        "action_on_add": {
            "type": "origins:invert",
            "action": {
                "type": "apoli:add_to_entity_set",
                "set": "*:soulweaver/given/stand-power_set"
            }
        }
    },

    "unravel-hit-set": {
        "type": "apoli:entity_set"
    },

    "unravel-hit-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 0.04,
        "green": 0.18,
        "blue": 0.62,
        "bientity_condition": {
            "type": "apoli:in_entity_set",
            "set": "*:*_unravel-hit-set"
        }
    },

    "validate": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "apoli:entity_set_size",
                                "set": "*:*_set",
                                "comparison": ">",
                                "compare_to": 0
                            },
                            {
                                "type": "origins:command",
                                "command": "execute unless score @s Supports.SW.LinkID matches 1..",
                                "comparison": "==",
                                "compare_to": 1
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/ensure-linkid"
                            },
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "*:*_set",
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "sync:execute_command",
                                            "command": "scoreboard players operation %t Supports.SW.ID = %a Supports.SW.ID",
                                            "actor_selector": "%a",
                                            "target_selector": "%t"
                                        },
                                        {
                                            "type": "sync:execute_command",
                                            "command": "scoreboard players operation %t Supports.SW.LinkID = %a Supports.SW.LinkID",
                                            "actor_selector": "%a",
                                            "target_selector": "%t"
                                        },
                                        {
                                            "type": "origins:invert",
                                            "action": {
                                                "type": "apoli:add_to_entity_set",
                                                "set": "*:soulweaver/given/stand-power_set"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    },
                    "else_action": {
                        "type": "origins:nothing"
                    }
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:soulweaver/validation/mark-matching-stand"
                },
                {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:command",
                        "command": "execute if entity @s[tag=Supports.Soulweaver.HasValidationStand]",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:selector_action",
                                "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.ValidationStand,limit=1]",
                                "bientity_action": {
                                    "type": "apoli:add_to_entity_set",
                                    "set": "mrt_supports:soulweaver/given/linked-player_set"
                                }
                            },
                            {
                                "type": "origins:selector_action",
                                "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.ValidationStand,limit=1]",
                                "bientity_action": {
                                    "type": "origins:invert",
                                    "action": {
                                        "type": "apoli:add_to_entity_set",
                                        "set": "*:soulweaver/given/stand-power_set"
                                    }
                                }
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/repair-linked-from-stand"
                            }
                        ]
                    },
                    "else_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:selector_action",
                                "selector": "@a",
                                "bientity_action": {
                                    "type": "origins:invert",
                                    "action": {
                                        "type": "apoli:remove_from_entity_set",
                                        "set": "mrt_supports:soulweaver/link_linked-set"
                                    }
                                }
                            },
                            {
                                "type": "origins:selector_action",
                                "selector": "@a",
                                "bientity_action": {
                                    "type": "origins:invert",
                                    "action": {
                                        "type": "apoli:remove_from_entity_set",
                                        "set": "mrt_supports:soulweaver/link_selected-set"
                                    }
                                }
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"⚠ Your soul was unwoven while you were away\",\"color\":\"#21AEFF\",\"bold\":true}"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                            }
                        ]
                    }
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:soulweaver/validation/clear-matching-stand"
                }
            ]
        }
    },

    "unlink-message": {
        "type": "apoli:action_on_sending_message",
        "filter": {
            "filter": "^Unlink$",
            "prevent": true,
            "before_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:execute_command",
                        "command": "scoreboard players operation $Unlink Supports.SW.ID = @s Supports.SW.ID"
                    },
                    {
                        "type": "origins:selector_action",
                        "selector": "@a[tag=Supports.Soulweaver.Owner]",
                        "bientity_action": {
                            "type": "origins:invert",
                            "action": {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                            }
                        }
                    },
                    {
                        "type": "origins:selector_action",
                        "selector": "@a[tag=Supports.Soulweaver.Owner]",
                        "bientity_action": {
                            "type": "origins:invert",
                            "action": {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                            }
                        }
                    },
                    {
                        "type": "origins:selector_action",
                        "selector": "@a",
                        "bientity_action": {
                            "type": "origins:if_else",
                            "condition": {
                                "type": "origins:target_condition",
                                "condition": {
                                    "type": "origins:and",
                                    "conditions": [
                                        {
                                            "type": "origins:power",
                                            "power": "mrt_supports:soulweaver/link"
                                        },
                                        {
                                            "type": "origins:command",
                                            "command": "execute if score @s Supports.SW.ID = $Unlink Supports.SW.ID",
                                            "comparison": "==",
                                            "compare_to": 1
                                        }
                                    ]
                                }
                            },
                            "if_action": {
                                "type": "sync:execute_command",
                                "command": "execute as %t run tellraw @s [{\"selector\":\"%a\",\"color\":\"#21AEFF\",\"bold\":true},{\"text\":\" has severed the thread\",\"color\":\"#21AEFF\",\"bold\":true}]",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            "else_action": {
                                "type": "origins:nothing"
                            }
                        }
                    },
                    {
                        "type": "origins:if_else",
                        "condition": {
                            "type": "origins:command",
                            "command": "execute as @a[tag=Supports.Soulweaver.Owner] if score @s Supports.SW.ID = $Unlink Supports.SW.ID",
                            "comparison": "==",
                            "compare_to": 0
                        },
                        "if_action": {
                            "type": "apoli:action_on_entity_set",
                            "set": "*:*_set",
                            "bientity_action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "sync:execute_command",
                                        "command": "execute in minecraft:overworld run summon armor_stand 8 -60 8 {NoGravity:1b,Invulnerable:1b,Invisible:1b,Marker:1b,CustomName:'[{\"selector\":\"%a\",\"color\":\"#21AEFF\",\"bold\":true}]',Tags:[\"Supports.Soulweaver.PendingSevered\",\"Supports.Soulweaver.NewPendingSevered\"]}",
                                        "actor_selector": "%a",
                                        "target_selector": "%t"
                                    },
                                    {
                                        "type": "sync:execute_command",
                                        "command": "execute in minecraft:overworld as @e[type=minecraft:armor_stand,tag=Supports.Soulweaver.NewPendingSevered,limit=1,sort=nearest] run scoreboard players operation @s Supports.SW.ID = %t Supports.SW.ID",
                                        "actor_selector": "%a",
                                        "target_selector": "%t"
                                    },
                                    {
                                        "type": "origins:target_action",
                                        "action": {
                                            "type": "origins:execute_command",
                                            "command": "execute in minecraft:overworld run tag @e[type=minecraft:armor_stand,tag=Supports.Soulweaver.NewPendingSevered] remove Supports.Soulweaver.NewPendingSevered"
                                        }
                                    }
                                ]
                            }
                        },
                        "else_action": {
                            "type": "origins:nothing"
                        }
                    },
                    {
                        "type": "origins:selector_action",
                        "selector": "@a",
                        "bientity_action": {
                            "type": "origins:invert",
                            "action": {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/link_linked-set"
                            }
                        }
                    },
                    {
                        "type": "origins:selector_action",
                        "selector": "@a",
                        "bientity_action": {
                            "type": "origins:invert",
                            "action": {
                                "type": "apoli:remove_from_entity_set",
                                "set": "mrt_supports:soulweaver/link_selected-set"
                            }
                        }
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "*:*_set",
                        "bientity_action": {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "kill @s"
                            }
                        }
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "function mrt_supports:soulweaver/validation/kill-matching-stand"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "title @s actionbar {\"text\":\"⚠ You have unwoven your soul\",\"color\":\"#21AEFF\",\"bold\":true}"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "function mrt_supports:soulweaver/effects/unlink-self"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                    }
                ]
            }
        }
    },

    "callback": {
        "type": "origins:action_on_callback",
        "entity_action_added": {
            "type": "origins:execute_command",
            "command": "tag @s add Supports.Soulweaver.LinkedEntity"
        },
        "entity_action_removed": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:soulweaver/buffs/clear"
        }
    }
}