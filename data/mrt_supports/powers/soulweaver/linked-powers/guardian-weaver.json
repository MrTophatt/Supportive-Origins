{
    "name": "Guardian Weaver",
    "description": "You wrap a chosen soul in the promise you could not keep for yourself. Their wounds may be drawn through the weave to you, and your bond can save them from death.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Guard the selected woven soul using %s"
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "You cannot Guard a woven soul that is also Resonated."
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "Saving a guarded soul prevents you from selecting another Guardian for 1 hour."
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Requires 5 woven souls",
                "color": "aqua"
            }
        }
    ],
    "type": "origins:multiple",

    "guarded-set": {
        "type": "apoli:entity_set",
        "action_on_add": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "sync:execute_command",
                    "command": "scoreboard players operation %t SW.GuardianID = %a Supports.SW.ID",
                    "actor_selector": "%a",
                    "target_selector": "%t"
                },
                {
                    "type": "origins:target_action",
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:execute_command",
                                "command": "power grant @s mrt_supports:soulweaver/given/guarded-soul mrt_supports:guardian_weaver"
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "tag @s add Supports.Soulweaver.Guarded"
                            }
                        ]
                    }
                }
            ]
        },
        "action_on_remove": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:execute_command",
                        "command": "power revoke @s mrt_supports:soulweaver/given/guarded-soul mrt_supports:guardian_weaver"
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "function mrt_supports:soulweaver/guardian/clear-guarded-soul"
                    }
                ]
            }
        }
    },

    "indicator-set": {
        "type": "apoli:entity_set"
    },
    
    "save-cooldown": {
        "type": "origins:cooldown",
        "cooldown": 72000,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
            "bar_index": 6
        }
    },
    "select": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/link_selected-set",
            "bientity_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                },
                "if_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "execute at @s run playsound minecraft:entity.allay.item_thrown player @a[distance=..24] ~ ~ ~ 0.8 0.75"
                            }
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "execute at @s run playsound minecraft:entity.allay.item_thrown player @a[distance=..24] ~ ~ ~ 0.8 0.75"
                            }
                        },
                        {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                        }
                    ]
                },
                "else_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "apoli:add_to_entity_set",
                            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "execute at @s run playsound minecraft:block.respawn_anchor.charge player @a[distance=..24] ~ ~ ~ 0.9 1.20"
                            }
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "execute at @s run playsound minecraft:block.respawn_anchor.charge player @a[distance=..24] ~ ~ ~ 0.9 1.20"
                            }
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
                                "bientity_condition": {
                                    "type": "apoli:in_entity_set",
                                    "set": "mrt_supports:soulweaver/link_selected-set",
                                    "inverted": true
                                },
                                "bientity_action": {
                                    "type": "apoli:remove_from_entity_set",
                                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                                }
                            }
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set",
                                "bientity_condition": {
                                    "type": "apoli:in_entity_set",
                                    "set": "mrt_supports:soulweaver/link_selected-set"
                                },
                                "bientity_action": {
                                    "type": "origins:and",
                                    "actions": [
                                        {
                                            "type": "origins:target_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/resonance/deselect-effect"
                                            }
                                        },
                                        {
                                            "type": "origins:actor_action",
                                            "action": {
                                                "type": "origins:execute_command",
                                                "command": "function mrt_supports:soulweaver/resonance/deselect-effect"
                                            }
                                        },
                                        {
                                            "type": "apoli:remove_from_entity_set",
                                            "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.nonary_active",
            "continuous": false
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": ">=",
                    "compare_to": 5
                },
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/guardian-weaver_save-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "not-enough-links-message": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"text\":\"Need 5 woven souls to use Guardian Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 20,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.nonary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": "<",
            "compare_to": 5
        }
    },
    "cooldown-message": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"text\":\"Guardian Weaver is still recovering\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 20,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.nonary_active",
            "continuous": false
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": ">=",
                    "compare_to": 5
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/guardian-weaver_save-cooldown",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        }
    },
    "no-selection-message": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"text\":\"Select a woven soul to use Guardian Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 20,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.nonary_active",
            "continuous": false
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": ">=",
                    "compare_to": 5
                },
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/guardian-weaver_save-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "maintain": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "bientity_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "origins:or",
                    "conditions": [
                        {
                            "type": "apoli:in_entity_set",
                            "set": "mrt_supports:soulweaver/link_linked-set",
                            "inverted": true
                        },
                        {
                            "type": "origins:actor_condition",
                            "condition": {
                                "type": "apoli:entity_set_size",
                                "set": "mrt_supports:soulweaver/link_stand-set",
                                "comparison": "<",
                                "compare_to": 5
                            }
                        }
                    ]
                },
                "if_action": {
                    "type": "apoli:remove_from_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                }
            }
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "guarded-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 1.0,
        "green": 0.30,
        "blue": 0.68,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "inverted": true
                }
            ]
        }
    },
    "selected-guarded-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 1.0,
        "green": 0.72,
        "blue": 0.90,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set"
                }
            ]
        }
    },
    "guarded-indicator-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 1.0,
        "green": 0.30,
        "blue": 0.68,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_far-indicator-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-indicator-set",
                    "inverted": true
                }
            ]
        }
    },
    "selected-guarded-indicator-glow": {
        "type": "origins:entity_glow",
        "use_teams": false,
        "red": 1.0,
        "green": 0.72,
        "blue": 0.90,
        "bientity_condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_far-indicator-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_indicator-set"
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-indicator-set"
                }
            ]
        }
    },
    "rescue-guarded-soul": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "bientity_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "origins:target_condition",
                    "condition": {
                                        "type": "origins:nbt",
                                        "nbt": "{Tags:[\"Supports.Soulweaver.GuardianSaved\"]}"
                    }
                },
                "if_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:and",
                                "actions": [
                                    {
                                        "type": "origins:execute_command",
                                        "command": "function mrt_supports:soulweaver/guardian/save-weaver"
                                    },
                                    {
                                        "type": "origins:grant_advancement",
                                        "advancement": "mrt_supports:soulweaver/guardian_angel"
                                    },
                                    {
                                        "type": "origins:trigger_cooldown",
                                        "power": "mrt_supports:soulweaver/linked-powers/guardian-weaver_save-cooldown"
                                    },
                                    {
                                        "type": "origins:trigger_cooldown",
                                        "power": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown"
                                    },
                                    {
                                        "type": "origins:trigger_cooldown",
                                        "power": "mrt_supports:soulweaver/linked-powers/cleanse_cleanse"
                                    },
                                    {
                                        "type": "origins:if_else",
                                        "condition": {
                                            "type": "origins:power_active",
                                            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
                                        },
                                        "if_action": {
                                            "type": "origins:toggle",
                                            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
                                        },
                                        "else_action": {
                                            "type": "origins:nothing"
                                        }
                                    },
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_resource",
                                        "operation": "set",
                                        "change": 0
                                    },
                                    {
                                        "type": "origins:change_resource",
                                        "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_delay",
                                        "operation": "set",
                                        "change": 0
                                    }
                                ]
                            }
                        },
                        {
                            "type": "origins:actor_action",
                            "action": {
                                "type": "origins:trigger_cooldown",
                                "power": "*:soulweaver/passives/see-health_cooldown"
                            }
                        },
                        {
                            "type": "sync:execute_command",
                            "command": "execute as %a run title @s actionbar [{\"text\":\"You saved \",\"color\":\"#289DA3\"},{\"selector\":\"%t\",\"color\":\"#65E9F7\",\"bold\":true}]",
                            "actor_selector": "%a",
                            "target_selector": "%t"
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/effects/unlink-owner"
                            }
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                            }
                        },
                        {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/link_linked-set"
                        },
                        {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/link_selected-set"
                        },
                        {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                        },
                        {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                        },
                        {
                            "type": "origins:target_action",
                            "action": {
                                "type": "origins:execute_command",
                                "command": "tag @s remove Supports.Soulweaver.GuardianSaved"
                            }
                        }
                    ]
                }
            }
        }
    },
    "cleanup": {
        "type": "origins:action_on_callback",
        "entity_action_added": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "bientity_action": {
                "type": "apoli:remove_from_entity_set",
                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
            }
        },
        "entity_action_removed": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "bientity_action": {
                "type": "apoli:remove_from_entity_set",
                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
            }
        },
        "entity_action_lost": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set",
            "bientity_action": {
                "type": "apoli:remove_from_entity_set",
                "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
            }
        }
    }
}
