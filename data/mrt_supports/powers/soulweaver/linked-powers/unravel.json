{
    "name": "Unravel",
    "description": "The lantern's flame remembers how to pull a soul's form apart. Cast a bolt of soul-fire that wounds its prey and leaves it exposed to greater harm.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "key": "key.origins.octonary_active",
            "text": "Cast Unravel with %s"
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Requires at least 4 woven souls",
                "color": "aqua"
            }
        }
    ],
    "type": "apoli:multiple",

    "hit-set": {
        "type": "apoli:entity_set"
    },

    "advancement-hit-set": {
        "type": "apoli:entity_set"
    },

    "hit-glow": {
        "type": "apoli:entity_glow",
        "use_teams": false,
        "red": 0.04,
        "green": 0.18,
        "blue": 0.62,
        "bientity_condition": {
            "type": "apoli:in_entity_set",
            "set": "*:*_hit-set"
        }
    },

    "cast": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/unravel_advancement-hit-set",
                    "bientity_action": {
                        "type": "apoli:remove_from_entity_set",
                        "set": "mrt_supports:soulweaver/linked-powers/unravel_advancement-hit-set"
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players set @s SW.UnravelHits 0"
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/lantern/animations_lantern-carrier-set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "tag @s add Supports.Soulweaver.UnravelTuck"
                        }
                    }
                },
                {
                    "type": "apoli:delay",
                    "ticks": 9,
                    "action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:fire_projectile",
                                "entity_type": "minecraft:llama_spit",
                                "speed": 3.0,
                                "divergence": 0.0,
                                "count": 1,
                                "tag": "{Tags:[\"Supports.Soulweaver.UnravelProjectile\"]}"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "playsound minecraft:entity.illusioner.cast_spell master @a[distance=..24] ~ ~ ~ 0.7 1.4"
                            },
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/lantern/animations_lantern-carrier-set",
                                "bientity_action": {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "tag @s remove Supports.Soulweaver.UnravelTuck"
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "cooldown": 500,
        "hud_render": {
            "sprite_location": "origins:textures/gui/sprites/hud_render/huang/resource_bar_01.png",
            "bar_index": 3
        },
        "key": {
            "key": "key.origins.octonary_active"
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": ">=",
            "compare_to": 4
        }
    },

    "not-enough-souls-message": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "title @s actionbar {\"text\":\"Need at least 4 woven souls to use Unravel\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.octonary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": "<=",
            "compare_to": 3
        }
    },

    "unravel-hit": {
        "type": "apoli:action_on_hit",
        "cooldown": 1,
        "bientity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:add_to_entity_set",
                    "set": "*:*_hit-set",
                    "time_limit": 120
                },
                {
                    "type": "apoli:add_to_entity_set",
                    "set": "*:*_advancement-hit-set"
                },
                {
                    "type": "apoli:actor_action",
                    "action": {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/unravel-hit"
                    }
                },
                {
                    "type": "apoli:actor_action",
                    "action": {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/marked-for-trouble/prepare"
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation %t SW.MarkOwner = %a Supports.SW.ID",
                    "actor_selector": "%a",
                    "target_selector": "%t"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation %t SW.MarkID = $NextMark SW.MarkID",
                    "actor_selector": "%a",
                    "target_selector": "%t"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute if entity %t[tag=Supports.Soulweaver.Adv.EchoSeen] if score %t SW.EchoOwner = %a Supports.SW.ID run advancement grant %a only mrt_supports:soulweaver/i_see_you complete",
                    "actor_selector": "%a",
                    "target_selector": "%t"
                },
                {
                    "type": "apoli:target_action",
                    "action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/effects/unravel-hit"
                            },
                            {
                                "type": "apoli:grant_power",
                                "power": "mrt_supports:soulweaver/given/unravel-target",
                                "source": "mrt_supports:soulweaver/given/unravel-target"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "tag @s add Supports.Soulweaver.UnravelTarget"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "tag @s add Supports.Soulweaver.Adv.Unraveled"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "scoreboard players set @s SW.AdvUnravelTTL 120"
                            },
                            {
                                "type": "apoli:selector_action",
                                "selector": "@s",
                                "bientity_action": {
                                    "type": "apoli:add_to_entity_set",
                                    "set": "mrt_supports:soulweaver/given/unravel-target_set",
                                    "time_limit": 120
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "apoli:actor_action",
                    "action": {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_linked-set",
                        "bientity_action": {
                            "type": "apoli:target_action",
                            "action": {
                                "type": "apoli:selector_action",
                                "selector": "@e[tag=Supports.Soulweaver.UnravelTarget,limit=1]",
                                "bientity_action": {
                                    "type": "apoli:add_to_entity_set",
                                    "set": "mrt_supports:soulweaver/given/linked-player_unravel-hit-set",
                                    "time_limit": 120
                                }
                            }
                        }
                    }
                },
                {
                    "type": "apoli:target_action",
                    "action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:damage",
                                "amount": 2.0,
                                "damage_type": "mrt_supports:unravel"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "tag @s remove Supports.Soulweaver.UnravelTarget"
                            }
                        ]
                    }
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:nbt",
                                    "nbt": "{Tags:[\"Supports.Soulweaver.LinkedEntity\"]}"
                                }
                            },
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:health",
                                    "comparison": "<=",
                                    "compare_to": 0.0
                                }
                            }
                        ]
                    },
                    "if_action": {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:grant_advancement",
                            "advancement": "mrt_supports:soulweaver/unraveled_weave"
                        }
                    },
                    "else_action": {
                        "type": "apoli:nothing"
                    }
                }
            ]
        },
        "damage_condition": {
            "type": "apoli:projectile",
            "projectile": "minecraft:llama_spit",
            "projectile_condition": {
                    "type": "apoli:nbt",
                    "nbt": "{Tags:[\"Supports.Soulweaver.UnravelProjectile\"]}"
            }
        },
        "bientity_condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:target_condition",
                    "condition": {
                        "type": "apoli:living"
                    }
                },
                {
                    "type": "apoli:target_condition",
                    "condition": {
                        "type": "apoli:in_tag",
                        "tag": "mrt_supports:non-living",
                        "inverted": true
                    }
                },
                {
                    "type": "apoli:target_condition",
                    "condition": {
                        "type": "apoli:tamed",
                        "inverted": true
                    }
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/link_linked-set",
                    "inverted": true
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/unravel_advancement-hit-set",
                    "inverted": true
                }
            ]
        }
    }
}
