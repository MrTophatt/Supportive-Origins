{
    "name": "Soul Recall",
    "description": "No distance can wholly silence a thread woven into your soul. Call a chosen woven soul to your side, or gather every soul in your weave.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "key": "key.origins.quaternary_active",
            "text": "Recall a selected soul, or hold the key without a selection to gather every woven soul, with %s"
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Single recall requires at least 1 woven soul",
                "color": "aqua"
            }
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Mass recall requires at least 2 woven souls",
                "color": "aqua"
            }
        }
    ],

    "type": "apoli:multiple",

    "single-tp-cooldown": {
        "type": "apoli:cooldown",
        "cooldown": 200,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/sprites/hud_render/apace/resource_bar.png",
            "bar_index": 3
        }
    },

    "all-tp-cooldown": {
        "type": "apoli:cooldown",
        "cooldown": 400,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/sprites/hud_render/apace/resource_bar.png",
            "bar_index": 3
        }
    },

    "all-tp-resource": {
        "type": "apoli:resource",
        "min": 0,
        "max": 60,
        "start_value": 0,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/sprites/hud_render/apace/resource_bar.png",
            "bar_index": 3,
            "condition": {
                "type": "apoli:resource",
                "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
                "comparison": ">",
                "compare_to": 0
            }
        },
        "max_action": {
            "type": "apoli:if_else",
            "condition": {
                "type": "apoli:entity_set_size",
                "set": "mrt_supports:soulweaver/link_stand-set",
                "comparison": ">=",
                "compare_to": 2
            },
            "if_action": {
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/recall"
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/mass-recall"
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_linked-set",
                        "bientity_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:dimension",
                                            "dimension": "minecraft:overworld"
                                        }
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:execute_command",
                                            "command": "scoreboard players set #Overworld SW.AdvRealm 1"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                },
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:dimension",
                                            "dimension": "minecraft:the_nether"
                                        }
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:execute_command",
                                            "command": "scoreboard players set #Nether SW.AdvRealm 1"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                },
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:dimension",
                                            "dimension": "minecraft:the_end"
                                        }
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:execute_command",
                                            "command": "scoreboard players set #End SW.AdvRealm 1"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/mass-recall-check"
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/advancements/everybody-in"
                    },
                    {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/effects/soul-recall-mass"
                    },
                    {
                        "type": "apoli:action_on_entity_set",
                        "set": "mrt_supports:soulweaver/link_linked-set",
                        "bientity_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-depart"
                                    }
                                },
                                {
                                    "type": "apoli:execute_command",
                                    "command": "tp %t %a",
                                    "actor_selector": "%a",
                                    "target_selector": "%t"
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-arrive"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "apoli:trigger_cooldown",
                        "power": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown"
                    },
                    {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
                        "operation": "set",
                        "change": 0
                    }
                ]
            },
            "else_action": {
                "type": "apoli:change_resource",
                "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
                "operation": "set",
                "change": 0
            }
        }
    },

    "single-tp": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/advancements/recall"
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:actor_condition",
                            "condition": {
                                "type": "apoli:sneaking"
                            }
                        },
                        "if_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:distance",
                                        "comparison": ">",
                                        "compare_to": 1000000.0
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:grant_advancement",
                                            "advancement": "mrt_supports:soulweaver/long_distance_relationship"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                },
                                {
                                    "type": "apoli:actor_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-depart"
                                    }
                                },
                                {
                                    "type": "apoli:execute_command",
                                    "command": "tp %a %t",
                                    "actor_selector": "%a",
                                    "target_selector": "%t"
                                },
                                {
                                    "type": "apoli:actor_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-arrive"
                                    }
                                }
                            ]
                        },
                        "else_action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:distance",
                                        "comparison": ">",
                                        "compare_to": 1000000.0
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:grant_advancement",
                                            "advancement": "mrt_supports:soulweaver/long_distance_relationship"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                },
                                {
                                    "type": "apoli:if_else",
                                    "condition": {
                                        "type": "apoli:target_condition",
                                        "condition": {
                                            "type": "apoli:health",
                                            "comparison": "<=",
                                            "compare_to": 2.0
                                        }
                                    },
                                    "if_action": {
                                        "type": "apoli:actor_action",
                                        "action": {
                                            "type": "apoli:grant_advancement",
                                            "advancement": "mrt_supports:soulweaver/by_a_thread"
                                        }
                                    },
                                    "else_action": {
                                        "type": "apoli:nothing"
                                    }
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-depart"
                                    }
                                },
                                {
                                    "type": "apoli:execute_command",
                                    "command": "tp %t %a",
                                    "actor_selector": "%a",
                                    "target_selector": "%t"
                                },
                                {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "function mrt_supports:soulweaver/effects/soul-recall-arrive"
                                    }
                                }
                            ]
                        }
                    }
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "mrt_supports:soulweaver/link_stand-set",
                        "comparison": ">",
                        "compare_to": 1
                    },
                    "if_action": {
                        "type": "apoli:trigger_cooldown",
                        "power": "mrt_supports:soulweaver/linked-powers/soul-recall_single-tp-cooldown"
                    },
                    "else_action": {
                        "type": "apoli:trigger_cooldown",
                        "power": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown"
                    }
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.quaternary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": ">=",
                    "compare_to": 1
                },
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_single-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "all-tp-charge": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
            "change": 1
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.quaternary_active",
            "continuous": true
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": ">=",
                    "compare_to": 2
                },
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_single-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "no-links-message": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "title @s actionbar {\"text\":\"Need at least 1 woven soul to use Soul Recall\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.quaternary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": "==",
            "compare_to": 0
        }
    },

    "mass-needs-two-message": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "title @s actionbar {\"text\":\"Need at least 2 woven souls to use Mass Soul Recall\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.quaternary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_stand-set",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "apoli:entity_set_size",
                    "set": "mrt_supports:soulweaver/link_selected-set",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "all-tp-resource-reset": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:if_else",
            "condition": {
                "type": "apoli:and",
                "conditions": [
                    {
                        "type": "apoli:entity_set_size",
                        "set": "mrt_supports:soulweaver/link_stand-set",
                        "comparison": ">=",
                        "compare_to": 2
                    },
                    {
                        "type": "apoli:entity_set_size",
                        "set": "mrt_supports:soulweaver/link_selected-set",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    {
                        "type": "apoli:key_pressed",
                        "key": {
                            "key": "key.origins.quaternary_active",
                            "continuous": true
                        }
                    },
                    {
                        "type": "apoli:resource",
                        "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_single-tp-cooldown",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    {
                        "type": "apoli:resource",
                        "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-cooldown",
                        "comparison": "==",
                        "compare_to": 0
                    }
                ]
            },
            "if_action": {
                "type": "apoli:nothing"
            },
            "else_action": {
                "type": "apoli:change_resource",
                "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
                "operation": "set",
                "change": 0
            }
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:soulweaver/linked-powers/soul-recall_all-tp-resource",
            "comparison": ">",
            "compare_to": 0
        }
    }
}
