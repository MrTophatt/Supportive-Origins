{
    "name": "Veil of the Beyond",
    "description": "You draw the Beyond over yourself like a quiet cloak. While veiled, you and your Soul Lantern vanish from sight and may pass through the thinnest places in the world.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/toggle.png",
            "key": "key.origins.septenary_active",
            "text": "Toggle the veil with %s"
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/info.png",
            "text": "You can only phase through most non-solid blocks, and blocks that don't block light."
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Requires at least 3 woven souls",
                "color": "aqua"
            }
        }
    ],
    "type": "apoli:multiple",

    "toggle": {
        "type": "apoli:toggle",
        "active_by_default": false,
        "retain_state": false,
        "key": {
            "key": "key.origins.septenary_active"
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": ">=",
            "compare_to": 3
        }
    },

    "resource": {
        "type": "apoli:resource",
        "min": 0,
        "max": 500,
        "start_value": 500,
        "hud_render": {
            "sprite_location": "origins:textures/gui/sprites/hud_render/huang/resource_bar_01.png",
            "bar_index": 5,
            "condition": {
                "type": "apoli:resource",
                "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_resource",
                "comparison": "!=",
                "compare_to": 500
            }
        }
    },

    "decrease": {
        "type": "apoli:action_over_time",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_resource",
                    "change": -2
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:resource",
                                "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_resource",
                                "comparison": "==",
                                "compare_to": 0
                            },
                            {
                                "type": "apoli:power_active",
                                "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
                            }
                        ]
                    },
                    "if_action": {
                        "type": "apoli:toggle",
                        "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
                    },
                    "else_action": {
                        "type": "apoli:nothing"
                    }
                }
            ]
        },
        "interval": 1,
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },

    "delay": {
        "type": "apoli:resource",
        "min": 0,
        "max": 7,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "increase": {
        "type": "apoli:action_over_time",
        "entity_action": {
            "type": "apoli:if_else",
            "condition": {
                "type": "apoli:resource",
                "resource": "*:*_delay",
                "comparison": "<",
                "compare_to": 7
            },
            "if_action": {
                "type": "apoli:change_resource",
                "resource": "*:*_delay",
                "change": 1
            },
            "else_action": {
                "type": "apoli:change_resource",
                "resource": "mrt_supports:soulweaver/linked-powers/veil-beyond_resource",
                "change": 1
            }
        },
        "falling_action": {
            "type": "apoli:change_resource",
            "resource": "*:*_delay",
            "operation": "set",
            "change": 0
        },
        "interval": 3,
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle",
            "inverted": true
        }
    },

    "invis": {
        "type": "apoli:invisibility",
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "hide-soul-lantern": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/lantern/animations_lantern-display-set",
            "bientity_action": {
                "type": "apoli:target_action",
                "action": {
                    "type": "apoli:execute_command",
                    "command": "execute unless data entity @s {block_state:{Name:\"minecraft:air\"}} run data merge entity @s {block_state:{Name:\"minecraft:air\"}}"
                }
            }
        },
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "show-soul-lantern": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "mrt_supports:soulweaver/lantern/animations_lantern-display-set",
            "bientity_action": {
                "type": "apoli:target_action",
                "action": {
                    "type": "apoli:execute_command",
                    "command": "execute unless data entity @s {block_state:{Name:\"minecraft:soul_lantern\"}} run data merge entity @s {block_state:{Name:\"minecraft:soul_lantern\"}}"
                }
            }
        },
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle",
            "inverted": true
        }
    },
    "speed": {
        "type": "apoli:conditioned_attribute",
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "operation": "addition",
            "value": 0.3
        },
        "tick_rate": 2,
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "step-height": {
        "type": "apoli:conditioned_attribute",
        "modifier": {
            "attribute": "porting_lib:step_height_addition",
            "operation": "addition",
            "value": 1
        },
        "tick_rate": 2,
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "phase": {
        "type": "apoli:phasing",
        "render_type": "blindness",
        "view_distance": 10,
        "block_condition": {
            "type": "apoli:or",
            "conditions": [
                {
                    "type": "apoli:light_blocking",
                    "inverted": true
                },
                {
                    "type": "apoli:water_loggable"
                },
                {
                    "type": "apoli:in_tag",
                    "tag": "mrt_supports:soul-phaseable"
                }
            ]
        },
        "phase_down_condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:sneaking"
                },
                {
                    "type": "apoli:on_block"
                }
            ]
        },
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "no-block-use": {
        "type": "apoli:prevent_block_use",
        "block_condition": {
            "type": "apoli:hardness",
            "comparison": ">=",
            "compare_to": 0
        },
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "no-block-select": {
        "type": "apoli:prevent_block_selection",
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },
    "no-entity-use": {
        "type": "apoli:prevent_entity_use",
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
        }
    },

    "advancement-targeted": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.Adv.VeilTargeted"
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@e[type=!#mrt_supports:non-living,distance=0.01..64]",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:invert",
                            "condition": {
                                "type": "apoli:attack_target"
                            }
                        },
                        "if_action": {
                            "type": "apoli:actor_action",
                            "action": {
                                "type": "apoli:execute_command",
                                "command": "tag @s add Supports.Soulweaver.Adv.VeilTargeted"
                            }
                        },
                        "else_action": {
                            "type": "apoli:nothing"
                        }
                    }
                }
            ]
        },
        "condition": {
            "type": "apoli:power_active",
            "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle",
            "inverted": true
        }
    },

    "advancement-activated": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/advancements/veil/activated"
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:health",
                                "comparison": "<",
                                "compare_to": 2.0
                            },
                            {
                                "type": "apoli:nbt",
                                "nbt": "{Tags:[\"Supports.Soulweaver.Adv.VeilTargeted\"]}"
                            }
                        ]
                    },
                    "if_action": {
                        "type": "apoli:grant_advancement",
                        "advancement": "mrt_supports:soulweaver/now_you_dont"
                    },
                    "else_action": {
                        "type": "apoli:nothing"
                    }
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.Adv.VeilTargeted"
                }
            ]
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:power_active",
                    "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle"
                },
                {
                    "type": "apoli:nbt",
                    "nbt": "{Tags:[\"Supports.Soulweaver.Adv.VeilActive\"]}",
                    "inverted": true
                }
            ]
        }
    },

    "advancement-deactivated": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:soulweaver/advancements/veil/deactivated"
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:power_active",
                    "power": "mrt_supports:soulweaver/linked-powers/veil-beyond_toggle",
                    "inverted": true
                },
                {
                    "type": "apoli:nbt",
                    "nbt": "{Tags:[\"Supports.Soulweaver.Adv.VeilActive\"]}"
                }
            ]
        }
    },

    "not-enough-souls-message": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "*:soulweaver/passives/see-health_cooldown"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "title @s actionbar {\"text\":\"Need at least 3 woven souls to use Veil of the Beyond\",\"color\":\"#21AEFF\",\"bold\":true}"
                }
            ]
        },
        "cooldown": 1,
        "key": {
            "key": "key.origins.septenary_active",
            "continuous": false
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "mrt_supports:soulweaver/link_stand-set",
            "comparison": "<=",
            "compare_to": 2
        }
    }
}
