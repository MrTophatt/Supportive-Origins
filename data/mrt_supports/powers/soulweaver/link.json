{
    "name": "Woven Bond",
    "description": "Entwine a soul with yourself, letting you sense their presence and well-being.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/star.png",
            "text": "Right-click a player to weave/detach their soul"
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/info.png",
            "text": "You cannot weave to other Soul Weavers, nor players woven to another Soul Weaver. You have a maximum of 5 links"
        }
    ],
    "type": "apoli:multiple",

    "counter": {
        "type": "apoli:resource",
        "min": 0,
        "max": 5,
        "start_value": 0,
        "hud_render": {
            "sprite_location": "mrt_supports:textures/gui/resource/soulweaver.png",
            "bar_index": 0
        }
    },

    "counter-apoli": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:if_else_list",
            "actions": [
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": ">=",
                        "compare_to": 5
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 5
                    }
                },
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": "==",
                        "compare_to": 4
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 4
                    }
                },
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": "==",
                        "compare_to": 3
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 3
                    }
                },
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": "==",
                        "compare_to": 2
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 2
                    }
                },
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": "==",
                        "compare_to": 1
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 1
                    }
                },
                {
                    "condition": {
                        "type": "apoli:entity_set_size",
                        "set": "*:*_stand-set",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "action": {
                        "type": "apoli:change_resource",
                        "resource": "mrt_supports:soulweaver/link_counter",
                        "operation": "set",
                        "change": 0
                    }
                }
            ]
        }
    },

    "buff-apoli": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:soulweaver/buffs/refresh-owner"
        }
    },

    "pending-severed-messages": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:soulweaver/validation/consume-pending-severed"
        }
    },

    "id": {
        "type": "apoli:action_on_callback",
        "entity_action_added": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:soulweaver/ensure-id"
        }
    },

    "stand-set": {
        "type": "apoli:entity_set"
    },

    "linked-set": {
        "type": "apoli:entity_set"
    },

    "selected-set": {
        "type": "apoli:entity_set"
    },

    "indicator-set": {
        "type": "apoli:entity_set"
    },

    "far-indicator-set": {
        "type": "apoli:entity_set"
    },

    "selected-indicator-set": {
        "type": "apoli:entity_set"
    },


    "reclaim-stands": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players operation $Repair Supports.SW.ID = @s Supports.SW.ID"
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.Linked]",
                    "bientity_action": {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:and",
                                "conditions": [
                                    {
                                        "type": "apoli:power",
                                        "power": "mrt_supports:soulweaver/given/stand-power"
                                    },
                                    {
                                        "type": "apoli:command",
                                        "command": "execute if score @s Supports.SW.ID = $Repair Supports.SW.ID",
                                        "comparison": "==",
                                        "compare_to": 1
                                    }
                                ]
                            }
                        },
                        "if_action": {
                            "type": "apoli:add_to_entity_set",
                            "set": "mrt_supports:soulweaver/link_stand-set"
                        },
                        "else_action": {
                            "type": "apoli:nothing"
                        }
                    }
                }
            ]
        }
    },

    "validate-linked-set": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:action_on_entity_set",
            "set": "*:*_linked-set",
            "bientity_action": {
                "type": "apoli:and",
                "actions": [
                    {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "function mrt_supports:soulweaver/validation/mark-matching-stand"
                        }
                    },
                    {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:selector_action",
                            "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.ValidationStand,limit=1]",
                            "bientity_action": {
                                "type": "apoli:and",
                                "actions": [
                                    {
                                        "type": "apoli:add_to_entity_set",
                                        "set": "mrt_supports:soulweaver/link_stand-set"
                                    },
                                    {
                                        "type": "apoli:execute_command",
                                        "command": "scoreboard players operation %t Supports.SW.ID = %a Supports.SW.ID",
                                        "actor_selector": "%a",
                                        "target_selector": "%t"
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "type": "apoli:if_else",
                        "condition": {
                            "type": "apoli:target_condition",
                            "condition": {
                                "type": "apoli:command",
                                "command": "execute if entity @s[tag=Supports.Soulweaver.HasValidationStand]",
                                "comparison": "==",
                                "compare_to": 1
                            }
                        },
                        "if_action": {
                            "type": "apoli:target_action",
                            "action": {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/repair-linked-from-stand"
                            }
                        },
                        "else_action": {
                            "type": "apoli:if_else",
                            "condition": {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:command",
                                    "command": "execute if score @s Supports.SW.LinkID matches 1..",
                                    "comparison": "==",
                                    "compare_to": 1
                                }
                            },
                            "if_action": {
                                "type": "apoli:and",
                                "actions": [
                                    {
                                        "type": "apoli:remove_from_entity_set",
                                        "set": "mrt_supports:soulweaver/link_selected-set"
                                    },
                                    {
                                        "type": "apoli:remove_from_entity_set",
                                        "set": "mrt_supports:soulweaver/link_linked-set"
                                    },
                                    {
                                        "type": "apoli:target_action",
                                        "action": {
                                            "type": "apoli:and",
                                            "actions": [
                                                {
                                                    "type": "apoli:execute_command",
                                                    "command": "title @s actionbar {\"text\":\"⚠ Your soul was unwoven while you were away\",\"color\":\"#21AEFF\",\"bold\":true}"
                                                },
                                                {
                                                    "type": "apoli:execute_command",
                                                    "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            },
                            "else_action": {
                                "type": "apoli:nothing"
                            }
                        }
                    },
                    {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:execute_command",
                            "command": "function mrt_supports:soulweaver/validation/clear-matching-stand"
                        }
                    }
                ]
            }
        },
        "condition": {
            "type": "apoli:entity_set_size",
            "set": "*:*_linked-set",
            "comparison": ">",
            "compare_to": 0
        }
    },


    "callback": {
        "type": "apoli:action_on_callback",
        "entity_action_added": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/ensure-id"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s add Supports.Soulweaver.Owner"
                }
            ]
        },
        "entity_action_removed": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/buffs/clear"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "origin set @s mrt_supports:strands origins:empty"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.Owner"
                }
            ]
        },
        "entity_action_lost": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/buffs/clear"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "origin set @s mrt_supports:strands origins:empty"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "tag @s remove Supports.Soulweaver.Owner"
                }
            ]
        }
    },




    "link": {
        "type": "apoli:action_on_entity_use",
        "bientity_action": {
            "type": "apoli:if_else_list",
            "actions": [
                {
                    "condition": {
                        "type": "apoli:target_condition",
                        "condition": {
                            "type": "origins:origin",
                            "origin": "mrt_supports:fractured_weaver",
                            "layer": "origins:origin"
                        }
                    },
                    "action": {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "title @s actionbar {\"text\":\"Cannot weave a fractured soul\",\"color\":\"#21AEFF\",\"bold\":true}"
                                },
                                {
                                    "type": "apoli:trigger_cooldown",
                                    "power": "*:soulweaver/passives/see-health_cooldown"
                                }
                            ]
                        }
                    }
                },
                {
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:power",
                                    "power": "mrt_supports:soulweaver/given/linked-player"
                                }
                            },
                            {
                                "type": "apoli:in_entity_set",
                                "set": "*:*_linked-set",
                                "inverted": true
                            }
                        ]
                    },
                    "action": {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "title @s actionbar {\"text\":\"⚠ The player's soul is weaved to another Soul Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                                },
                                {
                                    "type": "apoli:trigger_cooldown",
                                    "power": "*:soulweaver/passives/see-health_cooldown"
                                }
                            ]
                        }
                    }
                },
                {
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:power",
                                    "power": "mrt_supports:soulweaver/link"
                                }
                            },
                            {
                                "type": "apoli:in_entity_set",
                                "set": "*:*_linked-set",
                                "inverted": true
                            }
                        ]
                    },
                    "action": {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "title @s actionbar {\"text\":\"⚠ Cannot weave another Soul Weaver\",\"color\":\"#21AEFF\",\"bold\":true}"
                                },
                                {
                                    "type": "apoli:trigger_cooldown",
                                    "power": "*:soulweaver/passives/see-health_cooldown"
                                }
                            ]
                        }
                    }
                },
                {
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:actor_condition",
                                "condition": {
                                    "type": "apoli:entity_set_size",
                                    "set": "*:*_stand-set",
                                    "comparison": ">=",
                                    "compare_to": 5
                                }
                            },
                            {
                                "type": "apoli:in_entity_set",
                                "set": "*:*_linked-set",
                                "inverted": true
                            }
                        ]
                    },
                    "action": {
                        "type": "apoli:actor_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "title @s actionbar {\"text\":\"⚠ Max souls weaved\",\"color\":\"#21AEFF\",\"bold\":true}"
                                },
                                {
                                    "type": "apoli:trigger_cooldown",
                                    "power": "*:soulweaver/passives/see-health_cooldown"
                                }
                            ]
                        }
                    }
                },
                {
                    "condition": {
                        "type": "apoli:and",
                        "conditions": [
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:power",
                                    "power": "mrt_supports:soulweaver/given/linked-player",
                                    "inverted": true
                                }
                            },
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "apoli:power",
                                    "power": "mrt_supports:soulweaver/link",
                                    "inverted": true
                                }
                            },
                            {
                                "type": "apoli:actor_condition",
                                "condition": {
                                    "type": "apoli:entity_set_size",
                                    "set": "*:*_stand-set",
                                    "comparison": "<",
                                    "compare_to": 5
                                }
                            },
                            {
                                "type": "apoli:target_condition",
                                "condition": {
                                    "type": "origins:origin",
                                    "origin": "mrt_supports:fractured_weaver",
                                    "layer": "origins:origin",
                                    "inverted": true
                                }
                            }
                        ]
                    },
                    "action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:actor_action",
                                "action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "function mrt_supports:soulweaver/summon-stand"
                                        },
                                        {
                                            "type": "apoli:selector_action",
                                            "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.NewStand,sort=nearest,limit=1]",
                                            "bientity_action": {
                                                "type": "apoli:add_to_entity_set",
                                                "set": "mrt_supports:soulweaver/link_stand-set"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "execute as %a run scoreboard players operation %a Supports.SW.ID = @s Supports.SW.ID",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "execute as %t run scoreboard players operation @s Supports.SW.ID = %a Supports.SW.ID",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "execute as %t run scoreboard players operation @s Supports.SW.LinkID = $NextLink Supports.SW.LinkID",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:target_action",
                                "action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "apoli:power grant @s mrt_supports:soulweaver/given/linked-player mrt_supports:soulweaver"
                                        },
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "tag @s add Supports.Soulweaver.LinkedEntity"
                                        },
                                        {
                                            "type": "apoli:selector_action",
                                            "selector": "@e[type=minecraft:armor_stand,tag=Supports.Soulweaver.NewStand,sort=nearest,limit=1]",
                                            "bientity_action": {
                                                "type": "apoli:and",
                                                "actions": [
                                                    {
                                                        "type": "apoli:add_to_entity_set",
                                                        "set": "mrt_supports:soulweaver/given/linked-player_set"
                                                    },
                                                    {
                                                        "type": "apoli:invert",
                                                        "action": {
                                                            "type": "apoli:add_to_entity_set",
                                                            "set": "*:soulweaver/given/stand-power_set"
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "apoli:add_to_entity_set",
                                "set": "mrt_supports:soulweaver/link_linked-set"
                            },
                            {
                                "type": "apoli:actor_action",
                                "action": {
                                    "type": "apoli:and",
                                    "actions": [
                                        {
                                            "type": "apoli:grant_advancement",
                                            "advancement": "mrt_supports:soulweaver/first_thread"
                                        },
                                        {
                                            "type": "apoli:execute_command",
                                            "command": "tag @s add Supports.Soulweaver.Adv.LoneSoulFailed"
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "apoli:target_action",
                                "action": {
                                    "type": "apoli:execute_command",
                                    "command": "function mrt_supports:soulweaver/effects/link"
                                }
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "execute as %t run title @s actionbar [{\"selector\":\"%a\",\"color\":\"#21AEFF\",\"bold\":true},{\"text\":\" has woven your soul\",\"color\":\"#21AEFF\",\"bold\":true}]",
                                "actor_selector": "%a",
                                "target_selector": "%t"
                            },
                            {
                                "type": "apoli:actor_action",
                                "action": {
                                    "type": "apoli:execute_command",
                                    "command": "tag @e[type=minecraft:armor_stand,tag=Supports.Soulweaver.NewStand] remove Supports.Soulweaver.NewStand"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "bientity_condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:target_condition",
                    "condition": {
                        "type": "apoli:entity_type",
                        "entity_type": "minecraft:player"
                    }
                },
                {
                    "type": "apoli:in_entity_set",
                    "set": "*:*_linked-set",
                    "inverted": true
                }
            ]
        },
        "item_condition": {
            "type": "apoli:empty"
        },
        "hands": [
            "main_hand"
        ]
    },

    "unlink": {
        "type": "apoli:action_on_entity_use",
        "bientity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:remove_from_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/guardian-weaver_guarded-set"
                },
                {
                    "type": "apoli:remove_from_entity_set",
                    "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                },
                {
                    "type": "apoli:remove_from_entity_set",
                    "set": "mrt_supports:soulweaver/link_selected-set"
                },
                {
                    "type": "apoli:remove_from_entity_set",
                    "set": "mrt_supports:soulweaver/link_linked-set"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "execute as %t run title @s actionbar [{\"selector\":\"%a\",\"color\":\"#21AEFF\",\"bold\":true},{\"text\":\" has unwoven your soul\",\"color\":\"#21AEFF\",\"bold\":true}]",
                    "actor_selector": "%a",
                    "target_selector": "%t"
                },
                {
                    "type": "apoli:target_action",
                    "action": {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:soulweaver/effects/unlink-owner"
                    }
                },
                {
                    "type": "apoli:target_action",
                    "action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:action_on_entity_set",
                                "set": "mrt_supports:soulweaver/given/linked-player_set",
                                "bientity_action": {
                                    "type": "apoli:target_action",
                                    "action": {
                                        "type": "apoli:execute_command",
                                        "command": "kill @s"
                                    }
                                }
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/kill-matching-stand"
                            },
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:soulweaver/validation/cleanup-linked-self"
                            }
                        ]
                    }
                }
            ]
        },
        "bientity_condition": {
            "type": "apoli:in_entity_set",
            "set": "*:*_linked-set"
        },
        "item_condition": {
            "type": "apoli:empty"
        },
        "hands": [
            "main_hand"
        ]
    }
}
