{
    "name": "Strand of Renewal",
    "description": "The gentlest strand hums with the promise that no soul need fade alone. Its patient light steadily restores the wounds of its bearer.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/info.png",
            "text": "Gradually restores health, the rate strengthens with woven souls."
        }
    ],
    "type": "apoli:multiple",

    "switch-effects": {
        "type": "apoli:action_on_callback",
        "entity_action_gained": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players set @s SW.LanternStrand 0"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/strands/strand-switch-player-vfx"
                },
                {
                    "type": "apoli:apply_effect",
                    "effect": {
                        "effect": "minecraft:slowness",
                        "amplifier": 5,
                        "duration": 10,
                        "show_particles": false,
                        "show_icon": false
                    }
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/lantern/animations_lantern-display-set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "scoreboard players set @s SW.LanternStrand 0"
                                },
                                {
                                    "type": "apoli:execute_command",
                                    "command": "function mrt_supports:soulweaver/strands/strand-switch"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },
    
    "heal-0-1": {
        "type": "apoli:action_over_time",
        "interval": 40,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:heal",
                    "amount": 1.0
                },
                {
                    "type": "apoli:execute_command",
                    "command": "playsound minecraft:block.soul_soil.fall player @a[distance=..24] ~ ~ ~ 1 1.4"
                },
                {
                    "type": "apoli:spawn_particles",
                    "particle": "minecraft:sculk_soul",
                    "count": 20,
                    "speed": 0.02,
                    "spread": {
                        "x": 0.5,
                        "y": 0,
                        "z": 0.5
                    }
                }
            ]
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:relative_health",
                    "comparison": "<",
                    "compare_to": 1.0
                },
                {
                    "type": "apoli:scoreboard",
                    "objective": "SW.StrandLinks",
                    "comparison": "<=",
                    "compare_to": 1
                }
            ]
        }
    },

