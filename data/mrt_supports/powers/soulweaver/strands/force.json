{
    "name": "Strand of Force",
    "description": "The lantern's flame gathers into a steady pressure, waiting to be released. Your blows carry a stronger shove, and an open hand can unleash the gathered force.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "With an empty main hand, use its pulse to cast nearby unbound creatures away."
        },
        {
            "type": "origins:tooltip",
            "sprite": "mrt_supports:textures/gui/badge/soul-wisp.png",
            "text": {
                "text": "Requires 2 woven souls.",
                "color": "aqua"
            }
        }
    ],
    "type": "origins:multiple",

    "switch-effects": {
        "type": "origins:action_on_callback",
        "entity_action_gained": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "scoreboard players set @s SW.LanternStrand 3"
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:soulweaver/strands/strand-switch-player-vfx"
                },
                {
                    "type": "origins:apply_effect",
                    "effect": {
                        "effect": "minecraft:slowness",
                        "amplifier": 5,
                        "duration": 10,
                        "show_particles": false,
                        "show_icon": false
                    }
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/lantern/animations_lantern-display-set",
                    "bientity_action": {
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:and",
                            "actions": [
                                {
                                    "type": "origins:execute_command",
                                    "command": "scoreboard players set @s SW.LanternStrand 3"
                                },
                                {
                                    "type": "origins:execute_command",
                                    "command": "function mrt_supports:soulweaver/strands/strand-switch"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },
    
    "knockback-2-3": {
        "type": "origins:attribute",
        "modifier": {
            "attribute": "minecraft:generic.attack_knockback",
            "operation": "addition",
            "value": 0.10
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "apoli:scoreboard",
                    "objective": "SW.StrandLinks",
                    "comparison": "<=",
                    "compare_to": 3
                },
                {
                    "type": "apoli:scoreboard",
                    "objective": "SW.StrandLinks",
                    "comparison": ">=",
                    "compare_to": 2
                }
            ]
        }
    },
    "repulse-2-3": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:trigger_cooldown",
                    "power": "mrt_supports:soulweaver/strands/force-pulse-cooldown"
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:sonic_boom",
                    "count": 1,
                    "speed": 0,
                    "offset_y": 0.5,
                    "spread": {
                        "x": 0,
                        "y": 0,
                        "z": 0
                    }
                },
                {
                    "type": "origins:delay",
                    "ticks": 8,
                    "action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:area_of_effect",
                                "radius": 4.0,
                                "shape": "sphere",
                                "include_actor": false,
                                "bientity_condition": {
                                    "type": "origins:and",
                                    "conditions": [
                                        {
                                            "type": "origins:target_condition",
                                            "condition": {
                                                "type": "origins:entity_type",
                                                "entity_type": "minecraft:armor_stand",
                                                "inverted": true
                                            }
                                        },
                                        {
                                            "type": "apoli:in_entity_set",
                                            "set": "*:soulweaver/link_linked-set",
                                            "inverted": true
                                        }
                                    ]
                                },
                                "bientity_action": {
                                    "type": "origins:add_velocity",
                                    "x": 0.0,
                                    "y": 0.22,
                                    "z": 1.15,
                                    "reference": "position",
                                    "set": false
                                }
                            },
                            {
                                "type": "origins:play_sound",
                                "sound": "minecraft:block.amethyst_block.fall",
                                "volume": 1,
                                "pitch": 0.6
                            }
                        ]
                    }
                }
            ]
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.use",
            "continuous": false
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:equipped_item",
                    "equipment_slot": "mainhand",
                    "item_condition": {
                        "type": "origins:empty"
                    }
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:soulweaver/strands/force-pulse-cooldown",
                    "comparison": "==",
                    "compare_to": 0
