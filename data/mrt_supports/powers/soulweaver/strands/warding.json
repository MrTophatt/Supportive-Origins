{
    "name": "Strand of Warding",
    "description": "A watchful strand winds close, catching harm before it can reach the soul within. The lantern's flame blunts each blow turned against you.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/info.png",
            "text": "Shields you from harm, its protection grows with woven souls."
        }
    ],
    "type": "apoli:multiple",

    "switch-effects": {
        "type": "apoli:action_on_callback",
        "entity_action_gained": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "scoreboard players set @s SW.LanternStrand 1"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:soulweaver/strands/strand-switch-player-vfx"
                },
                {
                    "type": "apoli:apply_effect",
                    "effect": {
                        "effect": "minecraft:slowness",
                        "amplifier": 5,
                        "duration": 10,
                        "show_particles": false,
                        "show_icon": false
                    }
                },
                {
                    "type": "apoli:action_on_entity_set",
                    "set": "mrt_supports:soulweaver/lantern/animations_lantern-display-set",
                    "bientity_action": {
                        "type": "apoli:target_action",
                        "action": {
                            "type": "apoli:and",
                            "actions": [
                                {
                                    "type": "apoli:execute_command",
                                    "command": "scoreboard players set @s SW.LanternStrand 1"
                                },
                                {
                                    "type": "apoli:execute_command",
                                    "command": "function mrt_supports:soulweaver/strands/strand-switch"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    },
    
    "ward-0-1": {
        "type": "apoli:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total_multiplicative",
            "value": -0.10
        },
        "condition": {
            "type": "apoli:scoreboard",
            "objective": "SW.StrandLinks",
            "comparison": "<=",
            "compare_to": 1
        }
    },

    "ward-2-3": {
        "type": "apoli:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total_multiplicative",
            "value": -0.125
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:scoreboard",
                    "objective": "SW.StrandLinks",
                    "comparison": "<=",
                    "compare_to": 3
                },
                {
                    "type": "apoli:scoreboard",
                    "objective": "SW.StrandLinks",
                    "comparison": ">=",
                    "compare_to": 2
                }
            ]
        }
    },

    "ward-4": {
