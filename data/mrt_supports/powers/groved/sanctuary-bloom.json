{
    "name": "Sanctuary Bloom",
    "description": "Bloom a sheltered grove that softens harm, mends gentle life, veils those within, and turns projectiles aside.",
    "badges": [
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/toggle.png",
            "text": "Let your sanctuary bloom with %s, take it down with the same key."
        },
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/info.png",
            "text": "The barrier ricochets many projectiles."
        }
    ],
    "type": "origins:multiple",

    "meter": {
        "type": "origins:resource",
        "min": 0,
        "max": 900,
        "start_value": 900,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
            "bar_index": 8,
            "condition": {
                "type": "origins:resource",
                "resource": "*:*_meter",
                "comparison": "!=",
                "compare_to": 900
            }
        }
    },

    "toggle-state": {
        "type": "origins:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        },
        "max_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:groved/sanctuary/lifecycle/activate"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:happy_villager",
                    "count": 14,
                    "speed": 0.08,
                    "offset_y": 0.8,
                    "spread": {
                        "x": 0.9,
                        "y": 0.65,
                        "z": 0.9
                    }
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:cherry_leaves",
                    "count": 12,
                    "speed": 0.07,
                    "offset_y": 1.2,
                    "spread": {
                        "x": 1.1,
                        "y": 0.8,
                        "z": 1.1
                    }
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:spore_blossom_air",
                    "count": 8,
                    "speed": 0.035,
                    "offset_y": 1.0,
                    "spread": {
                        "x": 0.9,
                        "y": 0.8,
                        "z": 0.9
                    }
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:item.bone_meal.use",
                    "volume": 0.75,
                    "pitch": 0.85
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:block.flowering_azalea.break",
                    "volume": 0.65,
                    "pitch": 1.25
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:block.amethyst_block.chime",
                    "volume": 0.35,
                    "pitch": 1.55
                }
            ]
        },
        "min_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:groved/sanctuary/lifecycle/deactivate"
                },
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
                    "operation": "set",
                    "change": 30
                }
            ]
        }
    },

    "toggle": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:if_else",
            "condition": {
                "type": "origins:resource",
                "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                "comparison": "==",
                "compare_to": 1
            },
            "if_action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "origins:spawn_particles",
                        "particle": "minecraft:cherry_leaves",
                        "count": 6,
                        "speed": 0.04,
                        "offset_y": 1.0,
                        "spread": {
                            "x": 0.55,
                            "y": 0.7,
                            "z": 0.55
                        }
                    },
                    {
                        "type": "origins:play_sound",
                        "sound": "minecraft:block.azalea_leaves.break",
                        "volume": 0.55,
                        "pitch": 0.8
                    }
                ]
            },
            "else_action": {
                "type": "origins:if_else",
                "condition": {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_meter",
                    "comparison": "==",
                    "compare_to": 900
                },
                "if_action": {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "operation": "set",
                    "change": 1
                },
                "else_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:execute_command",
                            "command": "title @s actionbar {\"text\":\"Sanctuary Bloom must be fully recharged.\",\"color\":\"#8EDB75\",\"italic\":true}"
                        },
                        {
                            "type": "origins:play_sound",
                            "sound": "minecraft:block.azalea_leaves.hit",
                            "volume": 0.25,
                            "pitch": 0.65
                        }
                    ]
                }
            }
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        },
        "key": {
            "key": "key.origins.ternary_active",
            "continuous": false
        }
    },

    "drain": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_meter",
            "change": -1
        },
        "condition": {
            "type": "origins:resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
            "comparison": "==",
            "compare_to": 1
        }
    },

    "automatic-deactivation": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:spawn_particles",
                    "particle": "minecraft:spore_blossom_air",
                    "count": 6,
                    "speed": 0.025,
                    "offset_y": 1.0,
                    "spread": {
                        "x": 0.55,
                        "y": 0.75,
                        "z": 0.55
                    }
                },
                {
                    "type": "origins:play_sound",
                    "sound": "minecraft:block.azalea_leaves.break",
                    "volume": 0.5,
                    "pitch": 0.7
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_meter",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "recharge-delay": {
        "type": "origins:resource",
        "min": 0,
        "max": 30,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "recharge-delay-tick": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
            "change": -1
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        }
    },

    "shade-recharge": {
        "type": "origins:action_over_time",
        "interval": 4,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_meter",
            "change": 1
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_meter",
                    "comparison": "<",
                    "compare_to": 900
                },
                {
                    "type": "origins:exposed_to_sun",
                    "inverted": true
                }
            ]
        }
    },

    "sunlight-recharge": {
        "type": "origins:action_over_time",
        "interval": 2,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_meter",
            "change": 1
        },
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_recharge-delay",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "origins:resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_meter",
                    "comparison": "<",
                    "compare_to": 900
                },
                {
                    "type": "origins:exposed_to_sun"
                }
            ]
        }
    },

    "owner-validation": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:execute_command",
                "command": "function mrt_supports:groved/sanctuary/lifecycle/owner_validate"
        },
        "condition": {
            "type": "origins:resource",
            "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
            "comparison": "==",
            "compare_to": 1
        }
    },

    "missing-anchor-cleanup": {
        "type": "origins:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:groved/sanctuary/lifecycle/cleanup"
                }
            ]
        },
        "condition": {
            "type": "origins:nbt",
            "nbt": "{Tags:[\"Supports.Groved.SanctuaryAnchorMissing\"]}"
        }
    },

    "death-cleanup": {
        "type": "apoli:action_on_death",
        "bientity_action": {
            "type": "origins:target_action",
            "action": {
                "type": "origins:and",
                "actions": [
                    {
                        "type": "origins:change_resource",
                        "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                        "operation": "set",
                        "change": 0
                    },
                    {
                        "type": "origins:execute_command",
                        "command": "function mrt_supports:groved/sanctuary/lifecycle/cleanup"
                    }
                ]
            }
        }
    },

    "lifecycle-cleanup": {
        "type": "origins:action_on_callback",
        "entity_action_added": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:groved/sanctuary/lifecycle/owner_init"
        },
        "entity_action_respawned": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "mrt_supports:groved/sanctuary-bloom_toggle-state",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:groved/sanctuary/lifecycle/cleanup"
                }
            ]
        },
        "entity_action_removed": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:groved/sanctuary/lifecycle/cleanup"
        },
        "entity_action_lost": {
            "type": "origins:execute_command",
            "command": "function mrt_supports:groved/sanctuary/lifecycle/cleanup"
        }
    }
}
