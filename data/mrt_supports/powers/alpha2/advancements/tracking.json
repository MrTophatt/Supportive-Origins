{
    "hidden": true,
    "type": "apoli:multiple",

    "emergency-recharge": {
        "type": "apoli:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "ability-use-guard": {
        "type": "apoli:resource",
        "min": 0,
        "max": 2,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "clear-ability-use-guard": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "mrt_supports:alpha2/advancements/tracking_ability-use-guard",
            "operation": "add",
            "change": -1
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/advancements/tracking_ability-use-guard",
            "comparison": ">",
            "compare_to": 0
        }
    },

    "begin-emergency-recharge": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "mrt_supports:alpha2/advancements/tracking_emergency-recharge",
            "operation": "set",
            "change": 1
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "apoli:food_level",
                    "comparison": "<=",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/advancements/tracking_emergency-recharge",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "complete-emergency-recharge": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:grant_advancement",
                    "advancement": "mrt_supports:alpha2/emergency_recharge"
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/advancements/tracking_emergency-recharge",
                    "operation": "set",
                    "change": 0
                }
            ]
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/advancements/tracking_emergency-recharge",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "apoli:food_level",
                    "comparison": ">=",
                    "compare_to": 20
                }
            ]
        }
    },

    "hang-in-there": {
        "type": "apoli:action_over_time",
        "interval": 10,
        "entity_action": {
            "type": "apoli:grant_advancement",
            "advancement": "mrt_supports:alpha2/hang_in_there"
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:attached_to_rope"
                },
                {
                    "type": "apoli:on_block",
                    "inverted": true
                },
                {
                    "type": "apoli:command",
                    "command": "execute if entity @s[y=-2048,dy=2047]",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },

    "reset-on-respawn": {
        "type": "apoli:action_on_callback",
        "entity_action_respawned": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/advancements/tracking_emergency-recharge",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/advancements/tracking_ability-use-guard",
                    "operation": "set",
                    "change": 0
                }
            ]
        }
    }
}
