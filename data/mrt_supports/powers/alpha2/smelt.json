{
    "name": "Thermal Converter",
    "description": "Using your power, you can heat up materials in your hand and smelt them instantly, with a 12-second cooldown.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/star.png",
            "text": "Smelting items uses 4 energy"
        },
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "key": "key.origins.ternary_active",
            "text": "Smelt items in your main hand using %s"
        }
    ],
    "type": "apoli:active_self",
    "entity_action": {
        "type": "apoli:and",
        "actions": [
            {
                "type": "apoli:if_else",
                "condition": {
                    "type": "apoli:inventory",
                    "process_mode": "items",
                    "slot": "weapon.mainhand",
                    "comparison": "==",
                    "compare_to": 1
                },
                "if_action": {
                    "type": "apoli:grant_advancement",
                    "advancement": "mrt_supports:alpha2/inefficiency_at_its_finest"
                }
            },
            {
                "type": "apoli:if_else",
                "condition": {
                    "type": "apoli:inventory",
                    "process_mode": "items",
                    "slot": "weapon.mainhand",
                    "comparison": ">=",
                    "compare_to": 64
                },
                "if_action": {
                    "type": "apoli:grant_advancement",
                    "advancement": "mrt_supports:alpha2/efficiency_at_its_finest"
                }
            },
            {
                "type": "apoli:execute_command",
                "command": "item modify entity @s weapon.mainhand mrt_supports:smelt"
            },
            {
                "type": "apoli:feed",
                "food": -4,
                "saturation": 0
            },
            {
                "type": "apoli:execute_command",
                "command": "function mrt_supports:alpha2/thermal-converter-effects"
            }
        ]
    },
    "cooldown": 240,
    "key": {
        "key": "key.origins.ternary_active",
        "continuous": false
    },
    "hud_render": {
        "sprite_location": "origins:textures/gui/sprites/hud_render/huang/resource_bar_02.png",
        "bar_index": 15
    },
    "condition": {
        "type": "apoli:and",
        "conditions": [
            {
                "type": "apoli:food_level",
                "comparison": ">=",
                "compare_to": 4
            },
            {
                "type": "apoli:equipped_item",
                "equipment_slot": "mainhand",
                "item_condition": {
                    "type": "apoli:smeltable"
                }
            },
            {
                "type": "apoli:resource",
                "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                "comparison": "==",
                "compare_to": 0
            }
        ]
    }
}
