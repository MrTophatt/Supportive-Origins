{
    "name": "Winch",
    "description": "Fire a ripe at a solid block. Once attached, you can hang from the rope, reel yourself upward, lower yourself, or release the line at any time",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/star.png",
            "text": "Deploying your winch uses 5 energy | Need at least 6 energy to deploy"
        },
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Deploy & detach your winch with %s"
        }
    ],
    "type": "origins:active_self",
    "entity_action": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:if_else",
                "condition": {
                    "type": "apoli:attached_to_rope",
                    "comparison": "==",
                    "compare_to": 0
                },
                "if_action": {
                    "type": "origins:and",
                    "actions": [
                        {
                            "type": "origins:execute_command",
                            "command": "function mrt_supports:alpha2/winch/detach"
                        },
                        {
                            "type": "apoli:attach_rope",
                            "slot": "winch",
                            "mode": "rigid",
                            "stiffness": 0.5,
                            "slack_pull_rate": 6,
                            "max_length": 64
                        }
                    ]
                },
                "else_action": {
                    "type": "origins:if_else",
                    "condition": {
                        "type": "origins:and",
                        "conditions": [
                            {
                                "type": "origins:food_level",
                                "comparison": ">=",
                                "compare_to": 6
                            },
                            {
                                "type": "origins:resource",
                                "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                                "comparison": "==",
                                "compare_to": 0
                            }
                        ]
                    },
                    "if_action": {
                        "type": "origins:and",
                        "actions": [
                            {
                                "type": "origins:feed",
                                "food": -5,
                                "saturation": 0
                            },
                            {
                                "type": "origins:execute_command",
                                "command": "function mrt_supports:alpha2/winch/attach"
                            },
                            {
                                "type": "apoli:attach_rope",
                                "slot": "winch",
                                "mode": "rigid",
                                "stiffness": 0.5,
                                "slack_pull_rate": 6,
                                "max_length": 64
                            }
                        ]
                    }
                }
            }
        ]
    },
    "cooldown": 2,
    "key": {
        "key": "key.origins.quinary_active"
    }
}
