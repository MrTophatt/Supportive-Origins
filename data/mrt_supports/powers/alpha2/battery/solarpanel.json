{
    "name": "Solar Panels",
    "description": "Sunlight restores 1 energy every 5 seconds. Artificial light also works, restoring 1 energy every 15 seconds.",
    "type": "origins:multiple",

    "solar": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:feed",
                    "food": 1,
                    "saturation": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:alpha2/solar-charge-effects"
                }
            ]
        },
        "interval": 100,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:exposed_to_sun"
                },
                {
                    "type": "origins:food_level",
                    "comparison": "!=",
                    "compare_to": 20
                }
            ]
        }
    },

    "artificial": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:feed",
                    "food": 1,
                    "saturation": 0
                },
                {
                    "type": "origins:execute_command",
                    "command": "function mrt_supports:alpha2/solar-charge-effects"
                }
            ]
        },
        "interval": 300,
        "condition": {
            "type": "origins:and",
            "conditions": [
                {
                    "type": "origins:brightness",
                    "comparison": ">=",
                    "compare_to": 0.25
                },
                {
                    "type": "origins:exposed_to_sun",
                    "inverted": true
                },
                {
                    "type": "origins:food_level",
                    "comparison": "!=",
                    "compare_to": 20
                }
            ]
        }
    }
}
