{
    "name": "Power Saving Mode",
    "description": "At 0 energy, you enter Power Saving Mode, take 1 HP of damage every 5 seconds, and cannot use powered abilities. Normal operation resumes only after recharging to at least 5 energy.",
    "type": "apoli:multiple",

    "low-power-state": {
        "type": "apoli:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "enter-low-power": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:resource",
                        "resource": "mrt_supports:alpha2/advancements/tracking_ability-use-guard",
                        "comparison": "==",
                        "compare_to": 0
                    },
                    "if_action": {
                        "type": "apoli:grant_advancement",
                        "advancement": "mrt_supports:alpha2/running_on_fumes"
                    }
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                    "operation": "set",
                    "change": 1
                }
            ]
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:food_level",
                    "comparison": "<=",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },
    "exit-low-power": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "operation": "set",
            "change": 0
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:food_level",
                    "comparison": ">=",
                    "compare_to": 5
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                    "comparison": "==",
                    "compare_to": 1
                }
            ]
        }
    },
    "system-failure-damage": {
        "type": "apoli:damage_over_time",
        "interval": 100,
        "onset_delay": 1,
        "damage": 1,
        "damage_easy": 1,
        "damage_type": "minecraft:generic",
        "protection_enchantment": "minecraft:protection",
        "protection_effectiveness": 1.0,
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "comparison": "==",
            "compare_to": 1
        }
    },

    "speed": {
        "type": "apoli:conditioned_attribute",
        "modifier": {
            "attribute": "minecraft:generic.movement_speed",
            "operation": "multiply_total",
            "value": -0.6
        },
        "tick_rate": 1,
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "no-block-use": {
        "type": "apoli:prevent_block_use",
        "block_condition": {
            "type": "apoli:hardness",
            "comparison": ">=",
            "compare_to": 0
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "no-block-select": {
        "type": "apoli:prevent_block_selection",
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "comparison": "==",
            "compare_to": 1
        }
    },
    "low-power-sound": {
        "type": "apoli:action_over_time",
        "interval": 100,
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:alpha2/power-saving-effects"
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
            "comparison": "==",
            "compare_to": 1
        }
    }
}
