{
    "name": "Fabrication",
    "description": "have access to an internal crafting table at all times.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/star.png",
            "text": "Opening the crafting table uses 2 energy"
        },
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/active.png",
            "text": "Open your internal crafting table using %s"
        }
    ],

    "type": "origins:active_self",
    "entity_action": {
        "type": "origins:and",
        "actions": [
            {
                "type": "origins:execute_command",
                "command": "function mrt_supports:alpha2/fabrication-effects"
            },
            {
                "type": "origins:crafting_table"
            },
            {
                "type": "origins:feed",
                "food": -2,
                "saturation": 0
            }
        ]
    },
    "condition": {
        "type": "origins:and",
        "conditions": [
            {
                "type": "origins:food_level",
                "comparison": ">=",
                "compare_to": 2
            },
            {
                "type": "origins:resource",
                "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                "comparison": "==",
                "compare_to": 0
            }
        ]
    }
}
