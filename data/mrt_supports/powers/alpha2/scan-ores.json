{
    "name": "Seismic Ping",
    "description": "Send a twelve-second radial pulse that briefly highlights ores as it travels outward to 16 blocks.",
    "badges": [
        {
            "type": "origins:tooltip",
            "sprite": "origins:textures/gui/badge/isaacfanta/star.png",
            "text": "Scanning for ores uses 7 energy"
        },
        {
            "type": "origins:keybind",
            "sprite": "origins:textures/gui/badge/isaacfanta/active.png",
            "key": "key.origins.quaternary_active",
            "text": "Scan using %s"
        }
    ],
    "type": "apoli:multiple",

    "ping-shell": {
        "type": "apoli:resource",
        "min": 0,
        "max": 8,
        "start_value": 8,
        "hud_render": {
            "should_render": false
        }
    },

    "ping-active": {
        "type": "apoli:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },

    "shell-timer": {
        "type": "apoli:cooldown",
        "cooldown": 30,
        "hud_render": {
            "should_render": false
        }
    },

    "ore-glow": {
        "type": "apoli:active_self",
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/start"
                },
                {
                    "type": "apoli:feed",
                    "food": -7,
                    "saturation": 0
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/scan-ores_ping-shell",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/scan-ores_ping-active",
                    "operation": "set",
                    "change": 1
                },
                {
                    "type": "apoli:trigger_cooldown",
                    "power": "mrt_supports:alpha2/scan-ores_shell-timer"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:alpha2/seismic-ping/scan/render/first"
                },
                {
                    "type": "apoli:delay",
                    "ticks": 1,
                    "action": {
                        "type": "apoli:execute_command",
                        "command": "function mrt_supports:alpha2/seismic-ping/scan/render/second"
                    }
                }
            ]
        },
        "key": {
            "key": "key.origins.quaternary_active"
        },
        "cooldown": 1200,
        "hud_render": {
            "sprite_location": "origins:textures/gui/sprites/hud_render/spiderkolo/resource_bar_02.png",
            "bar_index": 3
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:food_level",
                    "comparison": ">=",
                    "compare_to": 7
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/battery/power-saving_low-power-state",
                    "comparison": "==",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/scan-ores_ping-active",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "shell-clock": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:execute_command",
                    "command": "function mrt_supports:alpha2/seismic-ping/cleanup/current-band"
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "mrt_supports:alpha2/scan-ores_ping-shell",
                    "operation": "add",
                    "change": 1
                },
                {
                    "type": "apoli:if_else",
                    "condition": {
                        "type": "apoli:resource",
                        "resource": "mrt_supports:alpha2/scan-ores_ping-shell",
                        "comparison": "<=",
                        "compare_to": 7
                    },
                    "if_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:trigger_cooldown",
                                "power": "mrt_supports:alpha2/scan-ores_shell-timer"
                            },
                            {
                                "type": "apoli:delay",
                                "ticks": 1,
                                "action": {
                                    "type": "apoli:execute_command",
                                    "command": "function mrt_supports:alpha2/seismic-ping/scan/render/first"
                                }
                            },
                            {
                                "type": "apoli:delay",
                                "ticks": 2,
                                "action": {
                                    "type": "apoli:execute_command",
                                    "command": "function mrt_supports:alpha2/seismic-ping/scan/render/second"
                                }
                            }
                        ]
                    },
                    "else_action": {
                        "type": "apoli:and",
                        "actions": [
                            {
                                "type": "apoli:execute_command",
                                "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/finish"
                            },
                            {
                                "type": "apoli:change_resource",
                                "resource": "mrt_supports:alpha2/scan-ores_ping-active",
                                "operation": "set",
                                "change": 0
                            }
                        ]
                    }
                }
            ]
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/scan-ores_ping-active",
                    "comparison": "==",
                    "compare_to": 1
                },
                {
                    "type": "apoli:resource",
                    "resource": "mrt_supports:alpha2/scan-ores_shell-timer",
                    "comparison": "==",
                    "compare_to": 0
                }
            ]
        }
    },

    "clear-highlight-on-broken-ore": {
        "type": "apoli:action_on_block_break",
        "only_when_harvested": false,
        "block_condition": {
            "type": "apoli:in_tag",
            "tag": "c:ores"
        },
        "block_action": {
            "type": "apoli:execute_command",
            "command": "execute as @e[type=minecraft:shulker,tag=Supports.Alpha02.OreHighlight,distance=..1] at @s run function mrt_supports:alpha2/seismic-ping/cleanup/kill/shulker"
        }
    },

    "clear-highlight-on-death": {
        "type": "apoli:action_on_death",
        "bientity_action": {
            "type": "apoli:target_action",
            "action": {
                "type": "apoli:execute_command",
                "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/abort"
            }
        }
    },

    "cleanup-on-lost": {
        "type": "apoli:action_on_callback",
        "entity_action_respawned": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/abort"
        },
        "entity_action_removed": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/abort"
        },
        "entity_action_lost": {
            "type": "apoli:execute_command",
            "command": "function mrt_supports:alpha2/seismic-ping/lifecycle/abort"
        }
    }
}
