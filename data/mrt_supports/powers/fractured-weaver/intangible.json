{
    "name": "Intangible",
    "description": "For a time, the world passes through your loosened soul. You cannot touch the physical world while unbound.",
    "type": "apoli:multiple",

    "prevent-block-selection": {
        "type": "apoli:prevent_block_selection"
    },

    "prevent-block-use": {
        "type": "apoli:prevent_block_use",
        "block_condition": {
            "type": "apoli:constant",
            "value": true
        }
    },

    "prevent-entity-use": {
        "type": "apoli:prevent_entity_use"
    },

    "prevent-entity-collision": {
        "type": "apoli:prevent_entity_collision"
    },

    "mobs-ignore": {
        "type": "apoli:scare_mobs"
    },

    "prevent-vibrations": {
        "type": "apoli:prevent_game_event",
        "tag": "minecraft:vibrations"
    },

    "prevent-item-pickup": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "entity_action": {
            "type": "apoli:execute_command",
            "command": "execute as @e[type=minecraft:item,distance=..3] run data merge entity @s {PickupDelay:10s}"
        }
    },

    "prevent-item-use": {
        "type": "apoli:prevent_item_use"
    },

    "prevent-sleep": {
        "type": "apoli:prevent_sleep",
        "message": "Your fractured soul cannot rest.",
        "set_spawn_point": false
    },

    "prevent-being-used": {
        "type": "apoli:prevent_being_used"
    },

    "prevent-damage-dealt": {
        "type": "apoli:modify_damage_dealt",
        "modifier": {
            "operation": "multiply_total",
            "value": -1
        }
    },

    "prevent-projectile-damage-dealt": {
        "type": "apoli:modify_projectile_damage",
        "modifier": {
            "operation": "multiply_total",
            "value": -1
        }
    },

    "damage-immunity": {
        "type": "apoli:invulnerability",
        "damage_condition": {
            "type": "apoli:constant",
            "value": true
        }
    },

    "effect-immunity": {
        "type": "apoli:effect_immunity",
        "effects": [],
        "inverted": true
    },

    "invisibility": {
        "type": "apoli:invisibility",
        "render_armor": false,
        "render_outline": false
    },

    "desaturate": {
        "type": "apoli:shader",
        "shader": "mrt_supports:shaders/post/intangible_desaturate.json",
        "toggleable": false
    }
}
