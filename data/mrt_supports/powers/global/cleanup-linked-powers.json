{
    "type": "apoli:multiple",

    "clear-resonant-strand": {
        "type": "apoli:action_on_callback",
        "entity_action_added": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:revoke_all_powers",
                    "source": "mrt_supports:soulweaver/strands"
                },
                {
                    "type": "apoli:revoke_all_powers",
                    "source": "mrt_supports:resonant_strand"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "apoli:power revoke @s mrt_supports:soulweaver/strands/force-pulse-cooldown from mrt_supports:resonant_strand_cooldown"
                },
                {
                    "type": "apoli:selector_action",
                    "selector": "@a[tag=Supports.Soulweaver.Owner]",
                    "bientity_action": {
                        "type": "apoli:invert",
                        "action": {
                            "type": "apoli:remove_from_entity_set",
                            "set": "mrt_supports:soulweaver/linked-powers/resonant-strand_resonate-set"
                        }
                    }
                }
            ]
        },
        "entity_action_respawned": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:revoke_all_powers",
                    "source": "mrt_supports:soulweaver/strands"
                },
                {
